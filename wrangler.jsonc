{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "omarchy",
  "account_id": "220c20627547d8661d630c98a00a79aa",
  "compatibility_date": "2026-09-06",
  "preview_urls": true,
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  }
}
