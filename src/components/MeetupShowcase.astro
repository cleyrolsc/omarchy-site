---
import SectionHeading from "./SectionHeading.astro";
import Brand from "./Brand.astro";
import SiteIcon from "./SiteIcon.astro";
import meetups from "../data/meetups.json";
export interface Props {}
const upcoming = meetups.events
  .filter(
    (event) =>
      Date.parse(event.start) >= Date.parse(`${meetups.refreshed}T00:00:00Z`),
  )
  .sort((a, b) => Date.parse(a.start) - Date.parse(b.start));
---

<SectionHeading
  wide
  anchor="meetups"
  title="Share the love of beautiful, fun & agentic Linux"
  description="Get together with others who love computers as much as you do. Share plugins, present work, and help newcomers into the community."
/>
<ul class="meetup-rail scroll-accent" aria-label="Upcoming Omarchy meetups">
  {
    upcoming.map((event, index) => (
      <li data-meetup-start={event.start} hidden={index >= 15}>
        <a class="meetup-card" href={event.url}>
          {event.cover ? (
            <img
              src={event.cover}
              alt={event.title}
              width={event.coverWidth}
              height={event.coverHeight}
              loading="lazy"
              decoding="async"
            />
          ) : (
            <div class="meetup-cover" role="img" aria-label="Omarchy Meetup">
              <svg
                viewBox="0 0 600 600"
                preserveAspectRatio="none"
                aria-hidden="true"
                fill="none"
              >
                <path
                  d="M0 105H105V0M0 135H135V0M465 600V465H600M495 600V495H600"
                  stroke="currentColor"
                  stroke-width="2"
                  opacity=".22"
                />
                <path
                  d="M35 225V35H225M375 565H565V375"
                  stroke="currentColor"
                  stroke-width="2"
                  opacity=".35"
                />
                <g fill="currentColor" opacity=".2">
                  <path d="M465 65h20v20h-20zM495 95h20v20h-20zM525 65h20v20h-20zM65 465h20v20H65zM95 495h20v20H95zM65 525h20v20H65z" />
                </g>
              </svg>
              <Brand />
              <span>MEETUP</span>
            </div>
          )}
          <>
            <p>
              <time datetime={event.start}>
                {new Intl.DateTimeFormat("en-US", {
                  month: "short",
                  day: "numeric",
                  year: "numeric",
                  timeZone: event.timezone || "UTC",
                }).format(new Date(event.start))}
              </time>
              {event.city ? ` · ${event.city}` : ""}
            </p>
            <h3>{event.title}</h3>
          </>
        </a>
      </li>
    ))
  }
  <li class="more">
    <a href="https://luma.com/omarchy"
      ><span>MORE</span><SiteIcon name="ArrowRight" /></a
    >
  </li>
</ul>
<p class="meetup-note">
  Don't see a meetup in your city? <a class="text-link" href="/meetups/"
    >Start your own</a
  >.
</p>
<style>
  .meetup-rail {
    margin: var(--space-6) 0 0;
    padding: 0 0 var(--space-5);
    display: flex;
    gap: var(--space-6);
    overflow-x: auto;
    scroll-snap-type: x proximity;
    list-style: none;
  }
  li {
    width: 42.5%;
    max-width: 15rem;
    flex-shrink: 0;
    scroll-snap-align: start;
  }
  a {
    display: block;
    text-decoration: none;
  }
  a:hover {
    text-decoration: none;
  }
  .meetup-card img,
  .meetup-cover {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    display: block;
  }
  .meetup-card p {
    margin: var(--space-3) 0 0;
    font-size: var(--text-xs);
    line-height: 1.333333;
    color: var(--color-text-muted);
  }
  h3 {
    margin: var(--space-1) 0 0;
    font-size: var(--text-lg);
    line-height: 1.555556;
    font-weight: 500;
    letter-spacing: normal;
    color: var(--color-text);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  a:hover h3 {
    color: var(--color-brand);
  }
  .more {
    width: 10rem;
  }
  .more a {
    display: flex;
    min-height: 10rem;
    height: auto;
    aspect-ratio: 16/9;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    font-size: var(--text-lg);
    color: var(--color-text);
  }
  .more a:hover {
    color: var(--color-brand);
  }
  .more span {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .meetup-note a {
    color: inherit;
    display: inline;
    white-space: nowrap;
    text-decoration: underline;
  }
  .meetup-note a:hover {
    color: var(--color-brand);
  }
  .meetup-note {
    margin-top: var(--space-6);
    font-size: var(--text-body);
    line-height: 1.625;
    color: var(--color-text-secondary);
  }
  .meetup-cover {
    container-type: inline-size;
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 8%;
    overflow: hidden;
    background: var(--color-bg-deep);
    padding-inline: 10%;
    color: var(--color-brand);
  }
  .meetup-cover svg {
    position: absolute;
    inset: 0;
    height: 100%;
    width: 100%;
  }
  .meetup-cover :global(.brand-wordmark) {
    position: relative;
    width: 100%;
  }
  .meetup-cover > span {
    position: relative;
    padding-left: 0.28em;
    font-size: clamp(1.5rem, 9cqw, 4rem);
    line-height: 1;
    letter-spacing: 0.28em;
  }
  @media (min-width: 40rem) {
    .more {
      width: 14rem;
    }
  }
  @media (min-width: 64rem) {
    .meetup-rail {
      margin-top: var(--space-10);
    }
  }
</style>
