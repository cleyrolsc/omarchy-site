---
import SectionHeading from "./SectionHeading.astro";
import MeetupCover from "./MeetupCover.astro";
import SiteIcon from "./SiteIcon.astro";
import { events, snapshotTime, inZone } from "../lib/meetups";
export interface Props {}
const upcoming = events
  .filter((e) => Date.parse(e.start) >= snapshotTime)
  .sort((a, b) => Date.parse(a.start) - Date.parse(b.start));
---

<div data-carousel data-rail-align="start">
  <div class="meetup-column">
    <SectionHeading
      roomy
      anchor="meetups"
      title="Share the love of beautiful, fun & agentic Linux"
    >
      <Fragment slot="description"
        >Get together with others who love computers as much as you do. <span
          class="description-line"
          >Share plugins, present work, and help newcomers into the community.</span
        ></Fragment
      >
      <div slot="action" class="meetup-actions">
        <a class="section-link" href="/meetups/"
          >All meetups<SiteIcon name="ArrowRight" size={20} /></a
        >
        <div class="meetup-arrows">
          <button
            class="btn"
            data-carousel-prev
            hidden
            aria-label="Previous meetups"
            ><SiteIcon name="ChevronLeft" size={20} /></button
          ><button
            class="btn"
            data-carousel-next
            hidden
            aria-label="Next meetups"
            ><SiteIcon name="ChevronRight" size={20} /></button>
        </div>
      </div>
    </SectionHeading>
  </div>
  <ul
    class="meetup-rail"
    data-carousel-rail
    aria-label="Upcoming Omarchy meetups"
  >
    {
      upcoming.map((event, index) => (
        <li
          data-slide={index}
          data-meetup-start={event.start}
          hidden={index >= 15}
        >
          <a class="meetup-card" href={event.url} draggable="false">
            {event.cover ? (
              <img
                src={event.cover}
                alt={event.title}
                width={event.coverWidth}
                height={event.coverHeight}
                loading="lazy"
                decoding="async"
                draggable="false"
              />
            ) : (
              <MeetupCover />
            )}
            <p>
              <time datetime={event.start}>
                {inZone(event, {
                  month: "short",
                  day: "numeric",
                  year: "numeric",
                })}
              </time>
              {event.city ? ` · ${event.city}` : ""}
            </p>
            <h3>{event.title}</h3>
          </a>
        </li>
      ))
    }
  </ul>
  <div class="meetup-column">
    <div class="meetup-track" aria-hidden="true">
      <div data-video-thumb></div>
    </div>
    <p class="meetup-note">
      Don't see a meetup in your city? <a class="text-link" href="/meetups/"
        >Start your own</a
      >.
    </p>
    <a class="section-link section-mobile-link" href="/meetups/"
      >All meetups<SiteIcon name="ArrowRight" size={20} /></a
    >
  </div>
</div>
<style>
  .meetup-column {
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: var(--space-4);
  }
  .meetup-actions {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--space-3);
  }
  .meetup-arrows {
    display: flex;
    gap: var(--space-2);
  }
  .meetup-arrows .btn {
    width: var(--space-10);
    height: var(--space-10);
    padding: 0;
  }
  .meetup-arrows .btn:disabled {
    opacity: 0.5;
    pointer-events: none;
  }
  .meetup-rail {
    position: relative;
    --rail-pad: max(1rem, calc((100% - min(100% - 2rem, 69rem)) / 2));
    margin: var(--space-6) 0 0;
    padding: 0 var(--rail-pad);
    scroll-padding-inline: var(--rail-pad);
    display: flex;
    gap: var(--space-6);
    overflow-x: auto;
    scrollbar-width: none;
    scroll-snap-type: x mandatory;
    list-style: none;
    cursor: grab;
    user-select: none;
  }
  .meetup-rail::-webkit-scrollbar {
    display: none;
  }
  .meetup-rail:active {
    cursor: grabbing;
  }
  li {
    width: 42.5%;
    flex-shrink: 0;
    scroll-snap-align: start;
    transition:
      opacity 300ms ease-out,
      filter 300ms ease-out;
  }
  li.is-outside {
    opacity: 0.4;
    filter: brightness(0.75);
  }
  .meetup-card {
    display: block;
    text-decoration: none;
  }
  img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    display: block;
  }
  .meetup-card p {
    margin: var(--space-3) 0 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: 1.333333;
    color: var(--color-text-muted);
  }
  h3 {
    margin: var(--space-1) 0 0;
    font-size: var(--text-lg);
    line-height: 1.555556;
    font-weight: 500;
    letter-spacing: normal;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .meetup-card:hover h3 {
    color: var(--color-brand);
  }
  .meetup-track {
    margin-top: var(--space-5);
    height: var(--space-2);
    background: color-mix(
      in oklch,
      var(--color-border-subtle) 50%,
      transparent
    );
  }
  .meetup-track > div {
    height: 100%;
    background: var(--color-brand);
    cursor: grab;
    touch-action: none;
    transition: background-color 150ms ease-out;
  }
  .meetup-track > div:hover {
    background: var(--t-field-hover);
  }
  .meetup-track > div:active {
    background: var(--t-field-crest);
    cursor: grabbing;
  }
  .meetup-note {
    margin: var(--space-6) 0 0;
    font-size: var(--text-body);
    line-height: 1.625;
    color: var(--color-text-secondary);
  }
  .meetup-note a {
    white-space: nowrap;
  }
  @media (min-width: 40rem) {
    .meetup-column {
      padding-inline: var(--space-6);
    }
    .meetup-rail {
      --rail-pad: max(1.5rem, calc((100% - min(100% - 3rem, 69rem)) / 2));
    }
    li {
      width: calc((100% - 3rem) / 3);
    }
  }
  @media (min-width: 48rem) {
    .description-line {
      display: block;
    }
  }
  @media (min-width: 64rem) {
    .meetup-rail {
      margin-top: var(--space-10);
    }
    li {
      width: calc((100% - 4.5rem) / 4);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    li {
      transition: none;
    }
  }
</style>
