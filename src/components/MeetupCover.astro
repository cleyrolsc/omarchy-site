---
import Brand from "./Brand.astro";
export interface Props {}
---

<div class="meetup-cover" role="img" aria-label="Omarchy Meetup">
  <svg
    viewBox="0 0 600 600"
    preserveAspectRatio="none"
    aria-hidden="true"
    fill="none"
  >
    <path
      d="M0 105H105V0M0 135H135V0M465 600V465H600M495 600V495H600"
      stroke="currentColor"
      stroke-width="2"
      opacity=".22"></path>
    <path
      d="M35 225V35H225M375 565H565V375"
      stroke="currentColor"
      stroke-width="2"
      opacity=".35"></path>
    <g fill="currentColor" opacity=".2">
      <path
        d="M465 65h20v20h-20zM495 95h20v20h-20zM525 65h20v20h-20zM65 465h20v20H65zM95 495h20v20H95zM65 525h20v20H65z"
      ></path>
    </g>
  </svg>
  <Brand />
  <span>MEETUP</span>
</div>
<style>
  .meetup-cover {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    display: block;
  }
  .meetup-card p {
    margin: var(--space-3) 0 0;
    font-size: var(--text-xs);
    line-height: 1.333333;
    color: var(--color-text-muted);
  }
  h3 {
    margin: var(--space-1) 0 0;
    font-size: var(--text-lg);
    line-height: 1.555556;
    font-weight: 500;
    letter-spacing: normal;
    color: var(--color-text);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  a:hover h3 {
    color: var(--color-brand);
  }
  .more {
    width: 10rem;
  }
  .more a {
    display: flex;
    min-height: 10rem;
    height: auto;
    aspect-ratio: 16/9;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    font-size: var(--text-lg);
    color: var(--color-text);
  }
  .more a:hover {
    color: var(--color-brand);
  }
  .more span {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .meetup-note a {
    color: inherit;
    display: inline;
    white-space: nowrap;
    text-decoration: underline;
  }
  .meetup-note a:hover {
    color: var(--color-brand);
  }
  .meetup-note {
    margin-top: var(--space-6);
    font-size: var(--text-body);
    line-height: 1.625;
    color: var(--color-text-secondary);
  }
  .meetup-cover {
    container-type: inline-size;
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 8%;
    overflow: hidden;
    background: var(--color-bg-deep);
    padding-inline: 10%;
    color: var(--color-brand);
  }
  .meetup-cover svg {
    position: absolute;
    inset: 0;
    height: 100%;
    width: 100%;
  }
  .meetup-cover :global(.brand-wordmark) {
    position: relative;
    width: 100%;
  }
  .meetup-cover > span {
    position: relative;
    padding-left: 0.28em;
    font-size: clamp(1.5rem, 9cqw, 4rem);
    line-height: 1;
    letter-spacing: 0.28em;
  }
  .meetup-cover {
    width: 100%;
    height: 100%;
    aspect-ratio: 1;
  }
</style>
