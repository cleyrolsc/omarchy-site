---
import Brand from "./Brand.astro";
import SiteIcon from "./SiteIcon.astro";
export interface Props {}
const groups = [
  {
    title: "Explore",
    links: [
      ["News", "/news/"],
      ["Manual", "/manual/"],
      ["Plugins", "https://plugins.omarchy.org"],
      ["Themes", "/themes/"],
    ],
  },
  {
    title: "Community",
    links: [
      ["Discord", "https://discord.gg/tXFUdasqhY"],
      ["Meetups", "/meetups/"],
      ["Teams", "/teams/"],
      ["Workstations", "/workstations/"],
    ],
  },
  {
    title: "Foundation",
    links: [
      ["About", "/foundation/"],
      ["Patrons", "/patrons/"],
      ["Sponsorships", "/sponsorships/"],
      ["Artists in Residence", "/air/"],
    ],
  },
  {
    title: "Project",
    links: [
      ["Security", "/security/"],
      ["GitHub", "https://github.com/omacom/omarchy"],
      ["Brand", "/brand/"],
      ["Merch", "https://supply.37signals.com/collections/omarchy"],
    ],
  },
];
---

<footer class="site-footer">
  <div class="footer-field footer-rise" aria-hidden="true">
    <canvas data-pixel-field="field"></canvas>
  </div>
  <div class="footer-inner footer-rise">
    <div class="footer-main">
      <div class="footer-brand">
        <a href="/" aria-label="Omarchy home" class="footer-home" data-quiet
          ><Brand /></a
        >
        <p class="footer-description" data-quiet>
          <span
            >Beautiful, fun &amp; agentic Linux <span class="byline"
              >by <a href="https://dhh.dk">DHH</a></span
            ></span
          >
          <span>The malleable OS for the age of agents.</span>
        </p>
        <div class="footer-credits">
          <p data-quiet>
            Incubated at <a href="https://37signals.com"
              ><SiteIcon
                name="ThirtySevenSignals"
                class="signals-mark"
                size={16}
              />37signals</a
            >
          </p>
          <p data-quiet>
            Hosting by <a href="https://cloudflare.com"
              ><SiteIcon
                name="Cloudflare"
                class="cloudflare-mark"
              />Cloudflare</a
            >
          </p>
        </div>
      </div>
      <div class="footer-nav">
        {
          groups.map((group) => (
            <nav aria-label={group.title} data-quiet>
              <>
                <h2>{group.title}</h2>
                <ul>
                  {group.links.map(([label, href]) => (
                    <li>
                      <a href={href}>{label}</a>
                    </li>
                  ))}
                </ul>
              </>
            </nav>
          ))
        }
      </div>
    </div>
    <div class="footer-meta">
      <p data-quiet><a href="/brand/">Omarchy™</a>. All rights reserved.</p>
      <p data-quiet>
        Partner inquiries: <a href="mailto:foundation@omarchy.org"
          >foundation@omarchy.org</a
        >
      </p>
    </div>
  </div>
</footer>
<style>
  .site-footer {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border-top: 1px solid var(--color-border-subtle);
    background: var(--t-field-bg);
    padding-bottom: env(safe-area-inset-bottom);
  }
  .footer-field {
    position: absolute;
    inset: 0;
    pointer-events: none;
    user-select: none;
  }
  canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
  .footer-inner {
    position: relative;
    max-width: var(--container-max);
    margin: auto;
    padding: var(--space-14) var(--space-4);
  }
  .footer-main {
    display: flex;
    flex-direction: column;
    gap: var(--space-10);
  }
  .footer-brand {
    display: flex;
    flex-direction: column;
    width: 100%;
    flex-shrink: 0;
  }
  .footer-home {
    display: block;
    color: var(--color-brand);
  }
  .footer-home :global(.brand-wordmark) {
    height: var(--space-6);
    width: auto;
    transition: background-color 150ms ease-out;
  }
  .footer-home:hover {
    color: var(--t-field-hover);
  }
  p {
    margin: 0;
    font-size: var(--text-sm);
    line-height: 1.625;
    color: var(--color-text-muted);
    text-wrap: pretty;
  }
  .footer-description {
    margin-top: var(--space-4);
  }
  .footer-description > span {
    display: block;
  }
  .byline {
    white-space: nowrap;
  }
  .footer-credits {
    margin-top: var(--space-4);
    display: flex;
    flex-direction: column;
  }
  .footer-credits :global(svg) {
    display: inline-block;
    flex-shrink: 0;
  }
  .footer-credits :global(.signals-mark) {
    width: 1rem;
    height: 1rem;
    margin-right: 3px;
    vertical-align: -0.28em;
  }
  .footer-credits :global(.cloudflare-mark) {
    width: calc(0.75rem * 256 / 116);
    height: 0.75rem;
    margin-right: 5px;
    vertical-align: -0.15em;
  }
  .footer-nav {
    display: grid;
    min-width: 0;
    flex: 1;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-10) var(--space-6);
  }
  h2 {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 400;
    line-height: 1.333333;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin: 0;
  }
  ul {
    display: flex;
    flex-direction: column;
    list-style: none;
    padding: 0;
    margin: var(--space-3_5) 0 0;
    gap: var(--space-2_5);
  }
  li {
    font-size: var(--text-base);
    line-height: 1.5;
  }
  li a {
    font-size: var(--text-sm);
    line-height: 1.428571;
  }
  a {
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: color 150ms ease-out;
  }
  a:hover {
    color: var(--color-text);
    text-decoration: none;
  }
  a:focus-visible {
    outline-offset: 2px;
  }
  .footer-meta {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-top: var(--space-12);
    border-top: 1px solid var(--color-border-subtle);
    padding-top: var(--space-6);
  }
  .footer-meta p {
    font-size: var(--text-caption);
    line-height: 1.5;
  }
  @media (min-width: 40rem) {
    .footer-inner {
      padding-inline: var(--space-6);
    }
    .footer-brand {
      width: max-content;
    }
    .footer-nav {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .footer-meta {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }
  @media (min-width: 64rem) {
    .footer-main {
      flex-direction: row;
      justify-content: space-between;
    }
    .footer-brand {
      width: 24rem;
    }
    .footer-credits {
      margin-top: auto;
    }
  }
  @media (min-width: 80rem) {
    .footer-nav {
      column-gap: var(--space-10);
    }
  }
</style>
