---
import SiteIcon from "./SiteIcon.astro";
import ThemePicker from "./ThemePicker.astro";
export interface Props {
  preview?: "search" | "themes";
}
const { preview } = Astro.props;
---

<dialog
  id="site-search"
  open={preview === "search"}
  aria-label="Search Omarchy"
>
  <div class="search-input-row">
    <SiteIcon name="Search" size={20} /><input
      id="site-search-input"
      type="search"
      placeholder="Search Omarchy"
      aria-label="Search Omarchy"
      autocomplete="off"
      spellcheck="false"
    /><button data-close-dialog aria-label="Close search"
      ><SiteIcon name="Cross" size={16} /></button>
  </div>
  <div class="search-scroll scroll-accent">
    <p class="search-status" role="status" data-search-status>
      The manual, the news, every plugin and every theme.
    </p><ul
      class="search-results"
      data-search-results
      aria-label="Search results"
    >
    </ul>
  </div>
  <div class="dialog-hint">
    <span><kbd>↑</kbd><kbd>↓</kbd> move</span><span><kbd>↵</kbd> open</span
    ><span><kbd>esc</kbd> close</span>
  </div>
</dialog>
<ThemePicker preview={preview === "themes"} />
<dialog id="site-media" aria-label="Media viewer">
  <button class="media-close" data-close-dialog aria-label="Close media viewer"
    ><SiteIcon name="Cross" size={24} /></button
  ><div data-media-content></div>
</dialog>
<style>
  dialog {
    width: min(42rem, calc(100vw - var(--space-8)));
    max-height: calc(100dvh - var(--space-12));
    margin: auto;
    padding: var(--space-6);
    border: 1px solid var(--color-border-strong);
    background: var(--color-bg);
    color: var(--color-text);
    box-shadow: var(--shadow-overlay);
    overflow: auto;
  }
  dialog::backdrop {
    background: color-mix(in srgb, var(--color-black), transparent 25%);
    backdrop-filter: blur(4px);
  }
  #site-search {
    position: fixed;
    inset: 12vh 0 auto;
    width: min(42rem, calc(100vw - 2rem));
    max-height: 70vh;
    padding: 0;
    border: 0;
    background: var(--color-surface);
    box-shadow: var(--shadow-card);
    overflow: hidden;
  }
  #site-search[open] {
    display: flex;
    flex-direction: column;
  }
  #site-search::backdrop {
    background: color-mix(in srgb, var(--color-black) 55%, transparent);
    backdrop-filter: none;
  }
  .search-input-row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding-inline: var(--space-4);
    border-bottom: 1px solid var(--color-border-subtle);
  }
  .search-input-row :global(svg) {
    flex-shrink: 0;
    color: var(--color-text-muted);
  }
  .search-input-row input {
    height: var(--space-14);
    min-width: 0;
    flex: 1;
    background: transparent;
    border: 0;
    padding: 0;
    font-size: var(--text-base);
    color: var(--color-text);
    outline: none;
  }
  input::-webkit-search-cancel-button {
    display: none;
  }
  input::placeholder {
    color: var(--color-text-muted);
  }
  .search-input-row button {
    position: relative;
    display: grid;
    place-items: center;
    width: var(--space-8);
    height: var(--space-8);
    margin-right: calc(-1 * var(--space-1));
    border: 0;
    padding: 0;
    background: none;
    color: var(--color-text-muted);
  }
  .search-scroll {
    min-height: 0;
    flex: 1;
    overflow-y: auto;
  }
  .search-status {
    padding: var(--space-8) var(--space-4);
    font-size: var(--text-sm);
    line-height: 1.428571;
    color: var(--color-text-muted);
    margin: 0;
  }
  .search-results {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .search-results :global(a) {
    display: block;
    width: 100%;
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--color-border-subtle);
    text-align: left;
    text-decoration: none;
  }
  .search-results :global(li:last-child a) {
    border-bottom: 0;
  }
  .search-results :global(a:hover),
  .search-results :global(a[data-selected]) {
    background: var(--color-surface-2);
  }
  .search-results :global(.search-result-title) {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
  }
  .search-results :global(strong) {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    line-height: 1.428571;
    font-weight: 500;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .search-results :global(.search-result-meta) {
    font-size: 11px;
    color: var(--color-text-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .search-results :global(.search-result-kind) {
    margin-left: auto;
    flex-shrink: 0;
    border: 1px solid var(--color-border-subtle);
    padding: 0 var(--space-1_5);
    font-size: 10px;
    letter-spacing: 0.025em;
    color: var(--color-text-muted);
    text-transform: uppercase;
  }
  .search-results :global(.search-snippet) {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
    margin-top: var(--space-1);
    font-size: var(--text-caption);
    line-height: 1.625;
    color: var(--color-text-secondary);
  }
  .search-results :global(mark) {
    background: none;
    color: var(--color-brand);
    font-weight: 500;
  }
  .dialog-hint {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: var(--space-4);
    border-top: 1px solid var(--color-border-subtle);
    padding: var(--space-2_5) var(--space-4);
    font-size: 11px;
    color: var(--color-text-muted);
  }
  kbd {
    margin-right: var(--space-1);
    border: 1px solid var(--color-border-strong);
    padding: 2px var(--space-1_5);
    font: inherit;
    color: var(--color-text-secondary);
    background: none;
    box-shadow: none;
  }
  #site-media {
    width: min(72rem, calc(100vw - var(--space-8)));
  }
  .media-close {
    margin: 0 0 var(--space-3) auto;
  }
  [data-media-content] :global(iframe) {
    width: 100%;
    aspect-ratio: 16 / 9;
    border: 0;
  }
  [data-media-content] :global(img) {
    display: block;
    margin: auto;
    max-height: 75dvh;
    object-fit: contain;
  }
</style>
