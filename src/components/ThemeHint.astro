---
import SiteIcon from "./SiteIcon.astro";
export interface Props {
  visible?: boolean;
}
const { visible = false } = Astro.props;
---

<aside class="theme-hint" data-theme-hint hidden={!visible} role="status">
  <button data-open-theme
    ><SiteIcon name="Brush" size={20} /><span
      ><strong>Change the theme</strong><span
        >Press T, or tap here. Inside Omarchy it is Super + Ctrl + Shift +
        Space.</span
      ></span
    ></button
  ><button data-hint-dismiss aria-label="Dismiss"
    ><SiteIcon name="Cross" size={16} /></button>
</aside>
<style>
  :global(body:has(.mobile-menu[open])) .theme-hint {
    display: none;
  }
  .theme-hint {
    position: fixed;
    top: 104px;
    right: var(--space-4);
    z-index: var(--z-dropdown);
    width: 18rem;
    max-width: calc(100vw - 2rem);
    background: var(--color-surface);
    box-shadow: var(--shadow-card);
    animation: notice-in 200ms ease-out both;
  }
  button {
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-text);
    text-align: left;
  }
  [data-open-theme] {
    display: flex;
    width: 100%;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-4);
    padding-right: var(--space-10);
    transition: background-color 150ms ease-out;
  }
  [data-open-theme]:hover {
    background: var(--color-surface-2);
  }
  [data-open-theme] :global(svg) {
    flex-shrink: 0;
    margin-top: 2px;
    color: var(--color-brand);
  }
  strong {
    display: block;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    line-height: 1.428571;
    font-weight: 500;
  }
  button > span > span {
    display: block;
    margin-top: var(--space-1);
    font-size: var(--text-caption);
    line-height: 1.625;
    color: var(--color-text-secondary);
  }
  [data-hint-dismiss] {
    position: absolute;
    top: var(--space-2);
    right: var(--space-2);
    display: grid;
    place-items: center;
    width: var(--space-8);
    height: var(--space-8);
    color: var(--color-text-muted);
  }
  @media (min-width: 40rem) {
    .theme-hint {
      top: 68px;
    }
  }
  @keyframes notice-in {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
