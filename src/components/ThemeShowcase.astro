---
import { SITE_THEMES } from "../lib/theme";
export interface Props {}
---

<div class="theme-showcase">
  <a href="/manual/themes/" class="theme-preview-link"
    ><img
      data-theme-preview
      src="/assets/images/theme-previews/tokyo-night.webp"
      alt="Tokyo Night desktop preview"
      width="1600"
      height="900"
      loading="lazy"
      decoding="async"
    /></a
  >
  <div class="theme-options" role="group" aria-label="Site theme">
    {
      SITE_THEMES.map((theme) => (
        <span class="theme-option">
          <button
            data-set-theme={theme.id}
            type="button"
            aria-pressed={theme.id === "tokyo-night"}
          >
            {theme.name}
          </button>
        </span>
      ))
    }
  </div>
  <p class="muted">
    Selected: <span data-theme-name>Tokyo Night</span>. <a
      class="text-link"
      href="/manual/themes/">Learn about themes</a
    >.
  </p>
</div>
<style>
  .theme-showcase {
    margin-top: var(--space-8);
  }
  .theme-options {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-6);
  }
  .theme-option:not(:last-child)::after {
    content: " /";
    margin-left: var(--space-2);
    color: var(--color-text-muted);
  }
  button {
    color: var(--color-text-secondary);
    background: transparent;
    border: 0;
    padding: var(--space-1) 0;
    font-size: var(--text-sm);
  }
  button:hover,
  button[aria-pressed="true"] {
    color: var(--color-brand);
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
  img {
    width: 100%;
    display: block;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    box-shadow: var(--shadow-card);
  }
  p {
    margin-top: var(--space-3);
  }
</style>
