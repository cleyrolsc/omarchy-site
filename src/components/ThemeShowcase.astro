---
import { SITE_THEMES } from "../lib/theme";
export interface Props {}
---

<div class="theme-showcase">
  <figure>
    <div class="theme-preview" data-theme-preview-stack>
      <img
        data-theme-preview
        src="/assets/images/theme-previews/tokyo-night.webp"
        alt="Tokyo Night on the desktop"
        width="1200"
        height="675"
        decoding="async"
      />
    </div>
  </figure>
  <ul class="theme-options" aria-label="Choose a theme">
    {
      SITE_THEMES.map((theme, index) => (
        <li>
          <button
            data-set-theme={theme.id}
            type="button"
            aria-pressed={theme.id === "tokyo-night"}
          >
            {theme.name}
          </button>
          {index < SITE_THEMES.length - 1 && <span aria-hidden="true">/</span>}
        </li>
      ))
    }
  </ul>
</div>
<style>
  .theme-showcase {
    margin-top: var(--space-6);
  }
  figure {
    margin: 0;
    overflow: hidden;
    background: var(--color-bg-deep);
    box-shadow: var(--shadow-card);
  }
  .theme-preview {
    position: relative;
    aspect-ratio: 16/9;
    background: var(--color-bg-deep);
  }
  .theme-preview :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 300ms ease-out;
    outline: 1px solid var(--t-img-outline);
    outline-offset: -1px;
  }
  .theme-options {
    margin: var(--space-4) 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-1) var(--space-2);
    font-size: var(--text-sm);
    line-height: 1.625;
  }
  li {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-2);
  }
  button {
    border: 0;
    padding: 0;
    background: none;
    color: var(--color-text-secondary);
    font-size: inherit;
    line-height: inherit;
    white-space: nowrap;
    text-underline-offset: 4px;
  }
  button:hover {
    text-decoration: underline;
    color: var(--color-text);
  }
  button[aria-pressed="true"] {
    color: var(--color-brand);
    text-decoration: underline;
  }
  li > span {
    color: var(--color-text-muted);
  }
  @media (min-width: 64rem) {
    .theme-showcase {
      margin-top: var(--space-10);
    }
    .theme-options {
      margin-top: var(--space-6);
    }
  }
</style>
