---
export interface Props {
  theme: { name: string; image: string; repo: string };
}
const { theme } = Astro.props;
const author = new URL(theme.repo).pathname.split("/")[1];
---

<article
  class="theme-card"
  data-theme-card
  data-search-text={`${theme.name} ${author}`.toLowerCase()}
>
  <a href={theme.repo}
    ><img
      src={theme.image}
      alt={`${theme.name} desktop preview`}
      width="1200"
      height="675"
      loading="lazy"
      decoding="async"
    /><div><h2>{theme.name}</h2><p>{author}</p></div></a
  >
</article>
<style>
  .theme-card {
    background: var(--color-surface);
    box-shadow: var(--shadow-card);
    overflow: hidden;
  }
  a {
    display: block;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }
  a:focus-visible {
    outline-offset: -3px;
  }
  img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }
  a > div {
    padding: var(--space-4);
  }
  h2 {
    font-size: var(--text-sm);
    margin: 0;
  }
  p {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    margin: var(--space-1) 0 0;
  }
  .theme-card:hover {
    box-shadow: var(--shadow-elevated);
  }
</style>
