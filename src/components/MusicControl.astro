---
import SiteIcon from "./SiteIcon.astro";
import { TRACK } from "../lib/music";
export interface Props {
  visible?: boolean;
}
const { visible = false } = Astro.props;
---

<aside
  class="music-control"
  data-music-control
  data-hero-quiet
  data-no-stamp
  hidden={!visible}
  aria-label="Background music"
>
  <button
    data-music-toggle
    aria-label="Turn the sound on"
    aria-pressed="false"
    title="Sound on"
    style={`background-image:url(${TRACK.art})`}
    ><span class="music-ring" data-music-ring></span><span class="music-symbol"
      ><SiteIcon name="VolumeOff" size={18} /><SiteIcon
        name="Volume"
        size={18}
      /></span
    ></button
  ><span class="music-info"
    ><strong>{TRACK.title.replace(/ \(.*\)$/, "")}</strong><span
      class="music-artist"
      ><span>{TRACK.artist}</span><span data-music-readout aria-hidden="true"
      ></span></span
    ></span
  ><span class="music-meter" aria-hidden="true"
    >{[0, 1, 2, 3].map(() => <span data-music-bar />)}</span
  ><span class="music-progress" data-music-progress aria-hidden="true"
  ></span><input
    class="music-seek"
    type="range"
    min="0"
    max="100"
    step="0.5"
    value="0"
    data-music-seek
    aria-label="Position in the track"
  />
</aside>
<style>
  .music-control {
    position: fixed;
    bottom: var(--space-5);
    left: var(--space-5);
    z-index: var(--z-dropdown);
    display: none;
    height: 46px;
    align-items: stretch;
    border: 1px solid var(--color-border-subtle);
    background: color-mix(in srgb, var(--color-bg) 85%, transparent);
    backdrop-filter: blur(4px);
    pointer-events: auto;
  }
  button {
    position: relative;
    width: var(--space-11);
    height: var(--space-11);
    align-self: center;
    flex-shrink: 0;
    padding: 0;
    border: 0;
    border-right: 1px solid var(--color-border-subtle);
    background-size: cover;
    background-position: center;
    color: var(--color-white);
    touch-action: manipulation;
  }
  .music-ring {
    position: absolute;
    inset: -1px;
    border: 1px solid var(--color-brand);
    pointer-events: none;
    animation: music-breathe 2.6s ease-in-out infinite;
  }
  @keyframes music-breathe {
    0%,
    100% {
      opacity: 0.25;
    }
    50% {
      opacity: 1;
    }
  }
  .music-symbol {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: color-mix(in srgb, var(--color-black) 45%, transparent);
    transition: opacity 150ms ease-out;
  }
  .music-symbol :global(svg:last-child),
  [aria-pressed="true"] .music-symbol :global(svg:first-child) {
    display: none;
  }
  [aria-pressed="true"] .music-symbol :global(svg:last-child) {
    display: block;
  }
  @media (hover: hover) {
    [aria-pressed="true"] .music-symbol {
      opacity: 0;
    }
    .music-control:hover .music-symbol,
    .music-control:has(:focus-visible) .music-symbol {
      opacity: 1;
    }
  }
  .music-info {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 0 var(--space-4) 0 var(--space-3);
    line-height: 1.25;
  }
  strong {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 500;
  }
  .music-artist {
    position: relative;
    margin-top: 2px;
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
  }
  .music-artist > span {
    transition: opacity 150ms ease-out;
  }
  [data-music-readout] {
    position: absolute;
    inset: 0;
    opacity: 0;
  }
  .music-control:has(input:is(:hover, :focus-visible, :active))
    .music-artist
    > span:first-child {
    opacity: 0;
  }
  .music-control:has(input:is(:hover, :focus-visible, :active))
    [data-music-readout] {
    opacity: 1;
  }
  .music-meter {
    display: flex;
    align-self: center;
    align-items: flex-end;
    gap: 2px;
    width: 18px;
    height: 12px;
    margin-right: var(--space-3);
  }
  .music-meter > span {
    display: block;
    width: 3px;
    height: 2px;
    flex-shrink: 0;
    background: var(--color-brand);
  }
  .music-progress {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    height: 2px;
    background: var(--color-brand);
    transform: scaleX(0);
    transform-origin: left;
    transition: height 150ms ease-out;
  }
  .music-control:hover .music-progress,
  .music-control:has(:focus-visible) .music-progress {
    height: 4px;
  }
  .music-seek {
    position: absolute;
    inset-inline: 0;
    bottom: -6px;
    height: 14px;
    width: 100%;
    cursor: pointer;
    appearance: none;
    background: transparent;
    touch-action: none;
    margin: 0;
  }
  .music-seek::-webkit-slider-thumb {
    appearance: none;
    width: 1px;
    height: 14px;
    background: transparent;
  }
  .music-seek::-moz-range-thumb {
    width: 1px;
    height: 14px;
    border: 0;
    background: transparent;
  }
  @media (min-width: 40rem) {
    .music-control {
      display: flex;
    }
  }
</style>
