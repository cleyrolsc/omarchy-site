---
/**
 * TypeScale — all `--text-*` tokens rendered as live type specimens.
 * Also surfaces weight, leading, and tracking primitives so the full
 * typography system is on one page.
 */
import BrandSection from "./BrandSection.astro";
---

<BrandSection
  kicker="02 — Typography"
  title="Type scale"
  description="Every <code>--text-*</code> token from <code>tokens.css</code>, rendered at its real size. The active font comes from <code>brand.css</code>. Headings use the tight tracking and line-height defaults declared in <code>base.css</code>."
>
  <div class="type-scale" data-type-scale>
    <div class="type-scale__empty">Loading tokens…</div>
  </div>

  <div class="type-aux">
    <div class="type-aux__col">
      <h3 class="type-aux__title">Weights</h3>
      <dl
        data-aux-group
        data-prefix="--font-"
        data-filter="regular|medium|semibold|bold|black"
      >
      </dl>
    </div>
    <div class="type-aux__col">
      <h3 class="type-aux__title">Line height</h3>
      <dl data-aux-group data-prefix="--leading-"></dl>
    </div>
    <div class="type-aux__col">
      <h3 class="type-aux__title">Tracking</h3>
      <dl data-aux-group data-prefix="--tracking-"></dl>
    </div>
  </div>
</BrandSection>

<script is:inline>
  (function () {
    var SAMPLE = "Build from a clear system.";

    function render(root) {
      var readTokens = window.__brandReadRootTokens;
      if (!readTokens) return;
      var tokens = readTokens("--text-");
      if (tokens.length === 0) {
        root.innerHTML =
          '<div class="type-scale__empty">No <code>--text-*</code> tokens found.</div>';
        return;
      }
      root.innerHTML = tokens
        .map(function (t) {
          return (
            '<div class="type-row">' +
            '<div class="type-row__meta">' +
            '<div class="type-row__name">' +
            t.shortName +
            "</div>" +
            '<div class="type-row__value">' +
            t.resolved +
            "</div>" +
            "</div>" +
            '<div class="type-row__sample" style="font-size:' +
            t.resolved +
            ';">' +
            SAMPLE +
            "</div>" +
            "</div>"
          );
        })
        .join("");
    }

    function renderAux(dl) {
      var readTokens = window.__brandReadRootTokens;
      if (!readTokens) return;
      var prefix = dl.getAttribute("data-prefix") || "--";
      var filter = dl.getAttribute("data-filter");
      var tokens = readTokens(prefix).filter(function (t) {
        return filter ? new RegExp(filter).test(t.shortName) : true;
      });
      if (tokens.length === 0) {
        dl.innerHTML = '<dt class="type-aux__empty">None defined</dt>';
        return;
      }
      dl.innerHTML = tokens
        .map(function (t) {
          return (
            '<div class="type-aux__row">' +
            "<dt>" +
            t.shortName +
            "</dt>" +
            "<dd>" +
            t.resolved +
            "</dd>" +
            "</div>"
          );
        })
        .join("");
    }

    function runAll() {
      document.querySelectorAll("[data-type-scale]").forEach(render);
      document.querySelectorAll("[data-aux-group]").forEach(renderAux);
    }

    if (document.readyState === "complete") {
      runAll();
    } else {
      window.addEventListener("load", runAll, { once: true });
    }
  })();
</script>

<style>
  .type-scale {
    display: flex;
    flex-direction: column;
  }

  .type-scale__empty {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .type-scale :global(.type-row) {
    display: grid;
    grid-template-columns: 10rem 1fr;
    gap: var(--space-6);
    align-items: baseline;
    padding-block: var(--space-4);
    border-block-end: 1px solid var(--color-border-muted);
  }
  .type-scale :global(.type-row:last-child) {
    border-block-end: 0;
  }

  .type-scale :global(.type-row__meta) {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .type-scale :global(.type-row__name) {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text);
  }
  .type-scale :global(.type-row__value) {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-faint);
  }

  .type-scale :global(.type-row__sample) {
    font-family: var(--font-sans);
    font-weight: var(--font-semibold);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-snug);
    color: var(--color-text);
  }

  .type-aux {
    margin-block-start: var(--space-8);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: var(--space-6);
  }
  .type-aux__title {
    font-size: var(--text-xs);
    font-weight: var(--font-bold);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--color-text-subtle);
    margin: 0 0 var(--space-3);
  }
  .type-aux :global(dl) {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .type-aux :global(.type-aux__row) {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--space-3);
    padding-block: var(--space-1);
    border-block-end: 1px solid var(--color-border-muted);
  }
  .type-aux :global(.type-aux__row:last-child) {
    border-block-end: 0;
  }
  .type-aux :global(dt) {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text);
  }
  .type-aux :global(dd) {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin: 0;
  }
</style>
