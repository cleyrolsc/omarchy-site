---
/**
 * BrandSection — shared shell used by every brand-reference component.
 * Gives the brand page a consistent visual rhythm without duplicating
 * the header markup in each component.
 */

export interface Props {
  kicker: string;
  title: string;
  description?: string;
}

const { kicker, title, description } = Astro.props;
---

<section class="brand-section">
  <header class="brand-section__head">
    <p class="brand-section__kicker">{kicker}</p>
    <h2 class="brand-section__title">{title}</h2>
    {description && <p class="brand-section__lead" set:html={description} />}
  </header>
  <div class="brand-section__body">
    <slot />
  </div>
</section>

<style>
  .brand-section {
    padding-block: var(--space-10);
    border-block-end: 1px solid var(--color-border);
  }
  .brand-section:last-child {
    border-block-end: 0;
  }

  .brand-section__head {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-block-end: var(--space-8);
    max-inline-size: 48rem;
  }

  .brand-section__kicker {
    font-size: var(--text-xs);
    font-weight: var(--font-bold);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--color-accent);
    margin: 0;
  }

  .brand-section__title {
    font-size: var(--text-3xl);
    font-weight: var(--font-bold);
    letter-spacing: var(--tracking-snug);
    color: var(--color-text);
    margin: 0;
  }

  .brand-section__lead {
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--color-text-muted);
    margin: 0;
    max-inline-size: 60ch;
  }

  .brand-section__lead :global(code) {
    font-family: var(--font-mono);
    font-size: 0.9em;
    color: var(--color-accent);
    background-color: rgba(255, 255, 255, 0.06);
    padding: 0.1em 0.4em;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border);
  }
</style>
