---
/**
 * Breakpoints — reference card for the `--bp-*` tokens. CSS custom
 * properties can't appear inside @media query conditions, so these
 * are documentation only — use the literal rem values in queries.
 */
import BrandSection from "./BrandSection.astro";
---

<BrandSection
  kicker="07 — Breakpoints"
  title="Viewport breakpoints"
  description="Reference-only. CSS custom properties can't be used inside <code>@media</code> conditions, so queries use the literal rem values: <code>@media (min-width: 48rem)</code>."
>
  <table class="breakpoints" data-breakpoints>
    <thead>
      <tr>
        <th>Name</th>
        <th>Token</th>
        <th>Min width</th>
        <th>Typical device</th>
      </tr>
    </thead>
    <tbody>
      <tr><td class="empty" colspan="4">Loading…</td></tr>
    </tbody>
  </table>
</BrandSection>

<script is:inline>
  (function () {
    var DEVICE_HINTS = {
      xs: "Small phone",
      sm: "Phone landscape",
      md: "Tablet portrait",
      lg: "Tablet landscape",
      xl: "Desktop",
      "2xl": "Wide desktop",
    };

    function render(table) {
      var readTokens = window.__brandReadRootTokens;
      if (!readTokens) return;
      var tokens = readTokens("--bp-");
      var tbody = table.querySelector("tbody");
      if (!tbody) return;
      if (tokens.length === 0) {
        tbody.innerHTML =
          '<tr><td class="empty" colspan="4">No <code>--bp-*</code> tokens found.</td></tr>';
        return;
      }
      tbody.innerHTML = tokens
        .map(function (t) {
          var device = DEVICE_HINTS[t.shortName] || "—";
          return (
            "<tr>" +
            "<td>" +
            t.shortName +
            "</td>" +
            '<td class="mono">' +
            t.name +
            "</td>" +
            '<td class="mono">' +
            t.resolved +
            "</td>" +
            "<td>" +
            device +
            "</td>" +
            "</tr>"
          );
        })
        .join("");
    }

    function runAll() {
      document.querySelectorAll("[data-breakpoints]").forEach(render);
    }

    if (document.readyState === "complete") {
      runAll();
    } else {
      window.addEventListener("load", runAll, { once: true });
    }
  })();
</script>

<style>
  .breakpoints {
    inline-size: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
  }
  .breakpoints th {
    text-align: start;
    font-size: var(--text-xs);
    font-weight: var(--font-bold);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--color-text-subtle);
    padding: var(--space-2) var(--space-3);
    border-block-end: 1px solid var(--color-border);
  }
  .breakpoints td {
    padding: var(--space-3);
    color: var(--color-text-muted);
    border-block-end: 1px solid var(--color-border-muted);
  }
  .breakpoints td:first-child {
    color: var(--color-text);
    font-family: var(--font-mono);
  }
  .breakpoints :global(.mono) {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }
  .breakpoints :global(.empty) {
    color: var(--color-text-faint);
    font-style: italic;
  }
</style>
