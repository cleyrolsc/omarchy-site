---
/**
 * BrandHeader — title block that sits above the brand tour. Reads the
 * project `name` and `description` from the live computed styles if
 * declared as `--brand-name` / `--brand-description`, otherwise falls
 * back to neutral copy so this works across projects.
 */

export interface Props {
  title?: string;
  subtitle?: string;
}

const {
  title = "Brand reference",
  subtitle = "Live from the project’s tokens.",
} = Astro.props;
---

<header class="brand-header">
  <p class="brand-header__kicker">Design system</p>
  <h1 class="brand-header__title">{title}</h1>
  <p class="brand-header__subtitle">{subtitle}</p>
  <p class="brand-header__note">
    Every value on this page is read from <code>:root</code> at runtime — same tokens
    the real site renders against. Update <code>src/styles/brand.css</code> or
    <code>tokens.css</code> and this page reflects the change immediately.
  </p>
</header>

<style>
  .brand-header {
    padding-block: var(--space-10) var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    max-inline-size: 48rem;
    border-block-end: 1px solid var(--color-border);
  }
  .brand-header__kicker {
    font-size: var(--text-xs);
    font-weight: var(--font-bold);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--color-accent);
    margin: 0;
  }
  .brand-header__title {
    font-size: var(--text-4xl);
    font-weight: var(--font-bold);
    letter-spacing: var(--tracking-tight);
    color: var(--color-text);
    margin: 0;
  }
  .brand-header__subtitle {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    margin: 0;
  }
  .brand-header__note {
    font-size: var(--text-sm);
    color: var(--color-text-subtle);
    margin-block-start: var(--space-4);
    max-inline-size: 60ch;
  }
  .brand-header :global(code) {
    font-family: var(--font-mono);
    font-size: 0.9em;
    color: var(--color-accent);
    background-color: rgba(255, 255, 255, 0.06);
    padding: 0.1em 0.4em;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border);
  }
</style>
