---
import voices from "../data/voices.json";
import { voiceLinks } from "../lib/voice-links";
import CardRail from "./CardRail.astro";
import SiteIcon from "./SiteIcon.astro";
export interface Props {}
const paragraphs = (text: string) => text.split(/\n{2,}/);
const shortDate = (iso: string) => {
  const [, m, d] = iso.split("-").map(Number);
  return `${"Jan Feb Mar Apr May Jun Jul Aug Sep Oct Nov Dec".split(" ")[m - 1]} ${d}`;
};
---

<div class="voices" data-voices-wall style="--voices-fold:42rem">
  <CardRail class="voices-columns"
    >{
      voices.map((post) => (
        <article class="voice-card">
          <>
            <header>
              <img
                src={post.avatar}
                alt=""
                width="96"
                height="96"
                loading="lazy"
                decoding="async"
              />
              <span class="voice-author">
                <span>{post.name}</span>
                <span>
                  @{post.handle} · {shortDate(post.date)}
                </span>
              </span>
              <a
                class="voice-link"
                href={post.url}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`Open the post by ${post.name} on X`}
              >
                <SiteIcon name="X" size={20} />
              </a>
            </header>
            <p>
              {paragraphs(post.text).map((paragraph) => (
                <span>
                  {voiceLinks(paragraph).map((part) =>
                    part.href ? (
                      <a
                        href={part.href}
                        target="_blank"
                        rel="noopener noreferrer"
                        class:list={[{ handle: part.text.startsWith("@") }]}
                      >
                        {part.text}
                      </a>
                    ) : (
                      part.text
                    ),
                  )}
                </span>
              ))}
            </p>
            {post.images?.length ? (
              <span class="voice-gallery">
                <span
                  class:list={[
                    "voice-images",
                    `voice-images--${Math.min(post.images.length, 4)}`,
                  ]}
                >
                  {post.images.slice(0, 4).map((src) => (
                    <img
                      src={src}
                      alt=""
                      width="800"
                      height="450"
                      loading="lazy"
                      decoding="async"
                    />
                  ))}
                </span>
                {post.video && (
                  <span class="video-badge">
                    <SiteIcon name="Play" size={20} />
                  </span>
                )}
              </span>
            ) : null}
          </>
        </article>
      ))
    }</CardRail
  >
</div>
<div class="voices-actions">
  <button class="btn" data-voices-toggle hidden aria-expanded="false"
    >View more</button
  >
</div>
<style>
  .voice-card {
    position: relative;
    display: flex;
    flex-direction: column;
    break-inside: avoid;
    gap: var(--space-4);
    padding: var(--space-6);
    margin-bottom: var(--space-4);
    background: var(--color-surface);
    box-shadow: var(--shadow-card);
    transition: box-shadow 150ms ease-out;
  }
  .voice-card:hover {
    box-shadow: var(--shadow-elevated);
  }
  header {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  header > img {
    width: var(--space-9);
    height: var(--space-9);
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
    background: var(--color-surface-2);
  }
  .voice-author {
    display: flex;
    flex-direction: column;
    min-width: 0;
    line-height: 1.25;
  }
  .voice-author > span {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: var(--text-sm);
    font-weight: 500;
  }
  .voice-author > span + span {
    font-size: var(--text-xs);
    font-weight: 400;
    color: var(--color-text-muted);
  }
  .voice-link {
    margin-left: auto;
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--space-8);
    height: var(--space-8);
    flex-shrink: 0;
    color: var(--color-text-muted);
  }
  .voice-link::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 10;
  }
  .voice-card:hover .voice-link {
    color: var(--color-text);
  }
  p {
    margin: 0;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 6;
    overflow: hidden;
    font-family: var(--font-sans);
    font-size: var(--text-body);
    line-height: 1.375;
    white-space: pre-line;
    color: var(--color-text-secondary);
    text-wrap: pretty;
  }
  p > span {
    display: block;
  }
  p > span + span {
    margin-top: var(--space-2);
  }
  p a {
    position: relative;
    z-index: 20;
    word-break: break-all;
    color: var(--color-text);
    text-decoration: underline;
    text-decoration-color: var(--color-border-strong);
    text-underline-offset: 3px;
  }
  p a.handle {
    white-space: nowrap;
    word-break: normal;
  }
  p a:hover {
    text-decoration-color: var(--color-brand);
  }
  .voice-gallery {
    display: block;
    position: relative;
    overflow: hidden;
  }
  .voice-images {
    display: grid;
    aspect-ratio: 16/9;
    gap: 2px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .voice-images--1 {
    grid-template-columns: 1fr;
  }
  .voice-images--3,
  .voice-images--4 {
    grid-template-rows: repeat(2, minmax(0, 1fr));
  }
  .voice-images--3 > img:first-child {
    grid-row: span 2;
  }
  .voice-images img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    min-height: 0;
  }
  .video-badge {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    display: grid;
    place-items: center;
    width: var(--space-11);
    height: var(--space-11);
    border-radius: 50%;
    color: var(--color-white);
    background: color-mix(in srgb, var(--color-black) 55%, transparent);
  }
  .voices-actions {
    display: none;
    margin-top: var(--space-6);
    justify-content: center;
  }
  @media (min-width: 40rem) {
    .voices :global(.voices-columns) {
      display: block;
      columns: 2;
    }
    .voices-actions {
      display: flex;
    }
  }
  @media (min-width: 64rem) {
    .voices :global(.voices-columns) {
      columns: 3;
    }
  }
</style>
