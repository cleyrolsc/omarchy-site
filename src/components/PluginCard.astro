---
export interface Props {
  plugin: {
    id: string;
    name: string;
    description: string;
    author: string | null;
    thumb: string | null;
    thumbW?: number | null;
    thumbH?: number | null;
    installCommand: string;
    verified?: boolean;
  };
}
const { plugin } = Astro.props;
---

<article class="plugin-card">
  <a
    class="plugin-link"
    href={`https://plugins.omarchy.org/plugin.html?id=${encodeURIComponent(plugin.id)}`}
  >
    {
      plugin.thumb ? (
        <img
          src={plugin.thumb}
          alt={`${plugin.name} preview`}
          width={plugin.thumbW || 640}
          height={plugin.thumbH || 360}
          loading="lazy"
          decoding="async"
        />
      ) : (
        <div class="plugin-placeholder" aria-hidden="true">
          {plugin.name.slice(0, 2)}
        </div>
      )
    }
    <div class="plugin-copy">
      <h3>
        {plugin.name}{plugin.verified && <span aria-label="Verified"> ✓</span>}
      </h3><p>{plugin.description}</p><span class="muted"
        >{plugin.author || "community"}</span>
    </div>
  </a>
  <button
    type="button"
    data-copy={plugin.installCommand}
    hidden
    aria-label={`Copy install command for ${plugin.name}`}
    >Copy install command</button
  >
</article>
<style>
  .plugin-card {
    display: flex;
    flex-direction: column;
    background: var(--color-surface);
    box-shadow: var(--shadow-card);
  }
  .plugin-link {
    display: block;
    flex: 1;
    text-decoration: none;
  }
  img,
  .plugin-placeholder {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    background: var(--color-bg-deep);
  }
  .plugin-placeholder {
    display: grid;
    place-items: center;
    font-size: var(--text-display);
    color: var(--color-brand);
  }
  .plugin-copy {
    padding: var(--space-4);
  }
  h3 {
    margin: 0;
    font-size: var(--text-sm);
  }
  h3 span {
    color: var(--color-brand);
  }
  p {
    color: var(--color-text-secondary);
    font-size: var(--text-caption);
    margin: var(--space-2) 0;
  }
  button {
    border: 0;
    border-top: 1px solid var(--color-border);
    background: transparent;
    color: var(--color-text-secondary);
    text-align: left;
    padding: var(--space-3) var(--space-4);
    font-size: var(--text-xs);
  }
  button:hover {
    color: var(--color-brand);
  }
</style>
