---
import SiteIcon from "./SiteIcon.astro";
export interface Props {
  title: string;
  description?: string;
  href?: string;
  link?: string;
  level?: 2 | 3;
  anchor?: string;
  wide?: boolean;
  roomy?: boolean;
  socialLink?: boolean;
}
const {
  title,
  description,
  href,
  link,
  level = 2,
  anchor,
  wide = false,
  roomy = false,
  socialLink = false,
} = Astro.props;
const Heading = level === 3 ? "h3" : "h2";
---

<div class="section-heading">
  <div class:list={["heading-copy", { wide, roomy }]}>
    <Heading
      >{
        anchor ? (
          <a class="section-anchor" href={`/#${anchor}`}>
            {title}
          </a>
        ) : (
          title
        )
      }</Heading
    >{
      Astro.slots.has("description") ? (
        <p>
          <slot name="description" />
        </p>
      ) : (
        description && <p>{description}</p>
      )
    }<slot />
  </div>
  {
    (href || Astro.slots.has("action")) && (
      <div class="heading-action">
        <slot name="action">
          <a class="section-link" href={href}>
            {socialLink ? (
              <>
                More on <SiteIcon name="X" size={20} />
              </>
            ) : (
              link
            )}
            <SiteIcon
              name={socialLink ? "ArrowUpRight" : "ArrowRight"}
              size={20}
            />
          </a>
        </slot>
      </div>
    )
  }
</div>
<style>
  .section-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-4);
  }
  .heading-copy {
    max-width: 36rem;
  }
  .heading-copy.roomy {
    max-width: 42rem;
  }
  .heading-copy.wide {
    max-width: none;
    min-width: 0;
  }
  h2,
  h3 {
    margin: 0;
    font-size: var(--text-2xl);
    line-height: 1.333333;
    font-weight: 600;
    letter-spacing: -0.025em;
    color: var(--color-text);
  }
  .section-anchor {
    color: inherit;
    text-decoration: none;
  }
  .section-anchor:hover {
    text-decoration: none;
  }
  p {
    margin: var(--space-2) 0 0;
    font-size: var(--text-body);
    line-height: 1.625;
    color: var(--color-text-secondary);
    text-wrap: pretty;
  }
  .heading-action {
    display: none;
    flex-shrink: 0;
  }
  @media (min-width: 40rem) {
    h2,
    h3 {
      font-size: var(--text-section-title);
      line-height: 1.333333;
    }
    .heading-action {
      display: block;
    }
  }
</style>
