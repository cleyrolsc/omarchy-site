---
export interface Props {
  to: string;
}
const { to } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head
    ><meta charset="utf-8" /><meta
      name="viewport"
      content="width=device-width,initial-scale=1"
    /><title>Redirecting - Omarchy</title><meta
      name="robots"
      content="noindex"
    /><meta http-equiv="refresh" content={`0;url=${to}`} /><link
      rel="canonical"
      href={new URL(to, "https://omarchy.org").href}
    /></head
  ><body
    ><main>
      <h1>This page moved</h1><p><a href={to}>Continue to {to}</a>.</p>
    </main></body>
</html>
