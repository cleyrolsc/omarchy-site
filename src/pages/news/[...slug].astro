---
import { render } from "astro:content";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { newsEntries, newsPath, excerpt } from "../../lib/content";
import { site } from "../../config/site";
export async function getStaticPaths() {
  return (await newsEntries()).map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const description = post.data.description || excerpt(post.body || "", 160);
const published = post.data.date.toISOString();
---

<SiteLayout
  title={post.data.title}
  description={description}
  canonicalPath={newsPath(post)}
  type="article"
  jsonLd={{
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: post.data.title,
    description,
    datePublished: published,
    author: {
      "@type": post.data.author_url ? "Person" : "Organization",
      name: post.data.author,
      url: post.data.author_url,
    },
    mainEntityOfPage: new URL(newsPath(post), site.url).href,
  }}
>
  <main id="main" class="page page--reading">
    <article>
      <a class="muted text-link" href="/news/">← All news</a><h1
        class="article-title"
      >
        {post.data.title}
      </h1><p class="muted">
        <time datetime={published}
          >{
            post.data.date.toLocaleDateString("en-US", {
              timeZone: "America/New_York",
              month: "long",
              day: "numeric",
              year: "numeric",
            })
          }</time
        > · {
          post.data.author_url ? (
            <a href={post.data.author_url}>{post.data.author}</a>
          ) : (
            post.data.author
          )
        }
      </p><div class="prose article-content"><Content /></div>
    </article>
  </main>
</SiteLayout>
<style>
  .article-title {
    margin: var(--space-6) 0 var(--space-3);
  }
  .article-content {
    margin-top: var(--space-8);
  }
</style>
