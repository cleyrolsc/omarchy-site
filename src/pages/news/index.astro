---
import SiteLayout from "../../layouts/SiteLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import SiteIcon from "../../components/SiteIcon.astro";
import { newsSummaries } from "../../lib/content";
const posts = await newsSummaries();
const date = (v: string) =>
  new Date(v).toLocaleDateString("en-US", {
    timeZone: "America/New_York",
    year: "numeric",
    month: "long",
    day: "numeric",
  });
---

<SiteLayout
  title="News - Omarchy"
  description="Announcements, releases, and other news from the Omarchy project."
  ><main id="main" class="page page--reading news-index">
    <PageHeader title="News" spaced /><ul>
      {
        posts.map((post) => (
          <li>
            <a href={post.path}>
              <>
                <time datetime={post.date}>{date(post.date)}</time>
                <span class="news-title">
                  {post.title}
                  <SiteIcon name="ArrowRight" size={20} />
                </span>
                {post.excerpt && (
                  <span class="news-excerpt">{post.excerpt}</span>
                )}
              </>
            </a>
          </li>
        ))
      }
    </ul>
  </main></SiteLayout
>
<style>
  .news-index {
    padding-block: var(--space-8);
  }
  ul {
    padding: 0;
    margin: 0;
    list-style: none;
  }
  li + li {
    border-top: 1px solid var(--color-border-subtle);
  }
  a {
    display: flex;
    flex-direction: column;
    gap: var(--space-1_5);
    padding-block: var(--space-6);
    text-decoration: none;
  }
  li:first-child > a {
    padding-top: 0;
  }
  time {
    font-size: var(--text-xs);
    line-height: 1.333333;
    color: var(--color-text-muted);
  }
  .news-title {
    display: flex;
    align-items: baseline;
    gap: var(--space-1_5);
    font-family: var(--font-sans);
    font-size: var(--text-lg);
    line-height: 1.555556;
    font-weight: 500;
    transition: color 150ms ease-out;
  }
  .news-title :global(svg) {
    flex-shrink: 0;
    align-self: center;
    color: var(--color-text-muted);
    transition:
      color 150ms ease-out,
      translate 150ms ease-out;
  }
  a:hover .news-title,
  a:hover :global(svg) {
    color: var(--color-brand);
  }
  a:hover :global(svg) {
    translate: 2px 0;
  }
  .news-excerpt {
    text-wrap: pretty;
    font-size: var(--text-sm);
    line-height: 1.625;
    color: var(--color-text-secondary);
  }
</style>
