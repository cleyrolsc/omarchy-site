---
import PageHeader from "../components/PageHeader.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import SiteIcon from "../components/SiteIcon.astro";
import teams from "../data/teams.json";
---

<SiteLayout
  title="Teams - Omarchy"
  description="The people guiding Omarchy: Core, Security, Design, and the Rangers."
  ><main id="main" class="page">
    <PageHeader title="Teams" />{
      teams.map((team) => (
        <section class="team-section" id={team.id}>
          <>
            <span
              id={`team-${team.id}`}
              class="team-anchor"
              aria-hidden="true"
            />
            <header>
              <>
                <h2>{team.name.replace(/^Omarchy /, "")}</h2>
                <p>{team.description}</p>
              </>
            </header>
            <ul class="members">
              {team.members.map((member) => (
                <li>
                  <a href={member.href || `#${team.id}`}>
                    <img
                      src={member.avatar}
                      alt=""
                      width="240"
                      height="240"
                      loading="lazy"
                      decoding="async"
                    />
                    <span class="member-name">
                      {member.name}
                      <SiteIcon name="ArrowUpRight" size={14} />
                    </span>
                    <p>{member.meta}</p>
                  </a>
                </li>
              ))}
            </ul>
          </>
          {team.note && (
            <p class="muted">
              {team.note.text.slice(
                0,
                team.note.linkText
                  ? team.note.text.indexOf(team.note.linkText)
                  : undefined,
              )}
              {team.note.href && (
                <a class="text-link" href={team.note.href}>
                  {team.note.linkText}
                </a>
              )}
              {team.note.linkText &&
                team.note.text.slice(
                  team.note.text.indexOf(team.note.linkText) +
                    team.note.linkText.length,
                )}
            </p>
          )}
        </section>
      ))
    }<section class="join">
      <div class="join-panel">
        <div>
          <h2>Not on a team? Neither is almost everyone.</h2><p>
            <span class="join-lead"
              >Most of Omarchy happens in the Discord and on GitHub:</span
            > Questions, themes, plugins, pull requests.
          </p>
        </div><div class="actions">
          <a
            class="btn btn--primary btn--lg"
            href="https://discord.gg/tXFUdasqhY"
            ><SiteIcon name="Discord" size={20} />Join the Discord</a
          ><a class="btn btn--lg" href="https://github.com/omacom/omarchy"
            ><SiteIcon name="Github" size={20} />Open GitHub</a
          >
        </div>
      </div>
    </section>
  </main></SiteLayout
>
<style>
  .page {
    padding-block: var(--space-8);
  }
  .team-section {
    position: relative;
    margin-top: var(--space-12);
    border-top: 1px solid var(--color-border-subtle);
    padding-top: var(--space-8);
    scroll-margin-top: calc(var(--nav-h) + 2rem);
  }
  .team-section:first-of-type {
    margin-top: var(--space-10);
  }
  .team-anchor {
    position: absolute;
    top: 0;
    scroll-margin-top: calc(var(--nav-h) + 2rem);
  }
  .team-section header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-1) var(--space-2);
  }
  h2 {
    margin: 0;
    font-size: var(--text-lg);
    line-height: 1.555556;
    font-weight: 500;
    letter-spacing: normal;
  }
  .team-section header p {
    margin: 0;
    font-size: var(--text-xs);
    line-height: 1.333333;
    color: var(--color-text-muted);
  }
  .members {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-7) var(--space-6);
    list-style: none;
    padding: 0;
    margin: var(--space-7) 0 0;
  }
  .members a {
    display: flex;
    height: 100%;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
    padding-block: var(--space-2);
    text-decoration: none;
  }
  .members img {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    box-shadow: 0 0 0 1px var(--color-border-subtle);
  }
  .member-name {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    line-height: 1.428571;
    font-weight: 500;
  }
  .member-name :global(svg) {
    opacity: 0;
    color: var(--color-text-muted);
  }
  .members a:hover .member-name {
    text-decoration: underline;
    text-decoration-color: var(--color-brand);
    text-underline-offset: 3px;
  }
  .members a:hover :global(svg),
  .members a:focus-visible :global(svg) {
    opacity: 1;
  }
  .members p {
    margin: calc(-1 * var(--space-3)) 0 0;
    font-size: var(--text-xs);
    line-height: 1.333333;
    color: var(--color-text-muted);
  }
  .team-section > .muted {
    margin: var(--space-8) 0 0;
    font-size: var(--text-xs);
    line-height: 1.333333;
  }
  .join {
    margin-top: var(--space-14);
    border-top: 1px solid var(--color-border-subtle);
    padding-top: var(--space-10);
  }
  .join-panel {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    background: var(--color-surface);
    box-shadow: var(--shadow-card);
    padding: var(--space-6);
  }
  .join-panel > div:first-child {
    max-width: 36rem;
  }
  @media (min-width: 48rem) {
    .join-lead {
      display: block;
    }
  }
  .join h2 {
    letter-spacing: -0.025em;
  }
  .join p {
    margin: var(--space-2) 0 0;
    font-size: var(--text-body);
    line-height: 1.625;
    color: var(--color-text-secondary);
    text-wrap: pretty;
  }
  .join .actions {
    gap: var(--space-2);
  }
  @media (min-width: 40rem) {
    .members {
      grid-template-columns: repeat(auto-fill, minmax(9rem, 1fr));
    }
    .join-panel {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }
</style>
