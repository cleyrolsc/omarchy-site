---
import SiteLayout from "../layouts/SiteLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import themes from "../data/themes.json";
---

<SiteLayout
  title="Themes - Omarchy"
  description="Community themes for Omarchy. Install them via Install > Style > Themes in Omarchy."
  ><main id="main" class="page themes-page">
    <div class="theme-intro">
      <PageHeader title="Community themes" narrow /><p>
        A theme restyles the whole system at once. Install these community
        themes via <strong>Install &gt; Style &gt; Themes</strong> in Omarchy. Want
        yours listed? Open a pull request on the site repository.
      </p>
    </div><ul class="themes-grid" data-themes-grid>
      {
        themes.map((theme) => (
          <li data-theme-card data-search-text={theme.name.toLowerCase()}>
            <a href={theme.repo}>
              <>
                <img
                  src={theme.image}
                  alt={`${theme.name} theme screenshot`}
                  width="1200"
                  height="675"
                  loading="lazy"
                  decoding="async"
                />
                <span>{theme.name}</span>
              </>
            </a>
          </li>
        ))
      }
    </ul>
  </main></SiteLayout
>
<style>
  .page {
    padding-block: var(--space-8);
  }
  .theme-intro {
    text-align: center;
  }
  .theme-intro p {
    max-width: 42rem;
    font-style: italic;
    margin: var(--space-3) auto 0;
    font-size: var(--text-body);
    line-height: 1.625;
    color: var(--color-text-secondary);
    text-wrap: pretty;
  }
  strong {
    font-weight: 500;
    color: var(--color-text);
  }
  .themes-grid {
    display: grid;
    gap: var(--space-7) var(--space-4);
    padding: 0;
    margin: var(--space-10) 0 0;
    list-style: none;
  }
  a {
    display: block;
    text-decoration: none;
  }
  img {
    display: block;
    width: 100%;
    aspect-ratio: 16/9;
    object-fit: cover;
    background: var(--color-bg-deep);
    outline: 1px solid var(--t-img-outline);
    outline-offset: -1px;
  }
  a > span {
    display: block;
    margin-top: var(--space-2_5);
    font-size: var(--text-caption);
    line-height: 1.5;
    color: var(--color-text-secondary);
    transition: color 150ms ease-out;
  }
  a:hover > span {
    color: var(--color-text);
  }
  @media (min-width: 40rem) {
    .themes-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 64rem) {
    .themes-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
