---
import { getEntry, render } from "astro:content";
import SiteLayout from "../layouts/SiteLayout.astro";
import Brand from "../components/Brand.astro";
import SiteIcon from "../components/SiteIcon.astro";
import EffectPicker from "../components/EffectPicker.astro";
import SectionHeading from "../components/SectionHeading.astro";
import PluginCard from "../components/PluginCard.astro";
import CardRail from "../components/CardRail.astro";
import FeatureShowcase from "../components/FeatureShowcase.astro";
import WindowsShowcase from "../components/WindowsShowcase.astro";
import MeetupShowcase from "../components/MeetupShowcase.astro";
import ThemeShowcase from "../components/ThemeShowcase.astro";
import VideoCarousel from "../components/VideoCarousel.astro";
import TeamClusters from "../components/TeamClusters.astro";
import NewsList from "../components/NewsList.astro";
import StatGrid from "../components/StatGrid.astro";
import Voices from "../components/Voices.astro";
import home from "../data/home.json";
import release from "../data/version.json";
import banner from "../data/banner.json";
import pluginStats from "../data/plugin-stats.json";
import catalogue from "../data/plugins.json";
import patrons from "../data/patrons.json";
import { newsSummaries } from "../lib/content";
const intro = (await getEntry("marketing", "home"))!;
const { Content } = await render(intro);
const news = await newsSummaries();
const featured = home.featuredPluginIds
  .map((id) => catalogue.plugins.find((p) => p.id === id))
  .filter((p): p is (typeof catalogue.plugins)[number] => Boolean(p));
const patronGroups = patrons
  .filter((group) => group.members.length > 0)
  .map((group) => ({
    ...group,
    name:
      group.id === "founding-token-patrons"
        ? "Founding Corporate Patrons"
        : group.name,
    description:
      group.id === "founding-patrons"
        ? "$1,000,000 from each"
        : group.id === "founding-token-patrons"
          ? "$1,000,000/year x 3 or $1,500,000 in tokens"
          : group.id === "distinguished-corporate-patrons"
            ? "$100,000/year x 3 or $150,000 in tokens"
            : "$100,000 from each",
  }));
---

<SiteLayout title={intro.data.title} description={intro.data.description}>
  <main id="main">
    <section id="home" class="hero pixel-container" data-hero-sentinel>
      <canvas data-pixel-field="hero" aria-hidden="true"></canvas><EffectPicker
      />
      <div class="hero-body">
        <div class="hero-spacer"></div>
        {
          banner && (
            <div class="hero-callout-wrap" data-hero-quiet>
              <a class="hero-callout" href={banner.href}>
                <>
                  <span set:html={banner.html} />
                  <SiteIcon name="ArrowRight" size={16} />
                </>
              </a>
            </div>
          )
        }
        <Brand hero class="hero-wordmark" />
        <div class="hero-copy" data-hero-quiet>
          <h1 data-hero-stagger style="--stagger:0">
            <a href="/#home" class="section-anchor"
              ><span class="sr-only">Omarchy: </span>Beautiful, fun &amp;
              agentic Linux</a
            > by <a href="https://dhh.dk" class="dhh-link">DHH</a>
          </h1>
          <p data-hero-stagger style="--stagger:1">
            <span>The malleable OS for the age of agents.</span><span
              >Vibe your way through every alteration, tweak, or trouble.</span
            >
          </p>
          <div
            class="hero-actions"
            data-hero-stagger
            data-hero-cta
            style="--stagger:2"
          >
            <a class="btn btn--primary" href="/#install"
              ><SiteIcon name="Download" size={20} />Get Omarchy</a
            ><a class="btn" href="/#watch"
              ><SiteIcon name="Play" size={20} />See it in action</a
            >
          </div>
        </div>
        <div class="hero-spacer"></div>
      </div>
    </section>
    <section id="about">
      <div class="section-inner intro-grid">
        <div>
          <h2 data-typed-block>
            <a class="section-anchor" href="/#about"
              ><span class="sr-only">We can fix everything.</span><span
                aria-hidden="true"
                >We can fix every<span data-typewriter>thing.</span><span
                  class="typed-caret"></span></span
              ></a
            >
          </h2><div class="intro-prose"><Content /></div>
        </div>
        <div class="quote-wrap">
          <figure class="quote">
            <span class="quote-mark" aria-hidden="true">“</span><blockquote
              cite={home.quote.href}
            >
              {home.quote.text}
            </blockquote><figcaption>
              <img
                src="/assets/images/team/dhh.webp"
                alt=""
                width="48"
                height="48"
                loading="lazy"
                decoding="async"
              /><span
                ><span class="quote-name">{home.quote.name}</span><span
                  >{home.quote.role}</span
                ></span
              ><a
                href={home.quote.href}
                aria-label="Watch him say it, on YouTube"
                ><SiteIcon name="Play" size={20} /></a
              >
            </figcaption>
          </figure>
        </div>
      </div>
      <div id="watch" class="watch-band section--deep" data-ground>
        <VideoCarousel videos={home.videos} />
      </div>
      <div id="install" class="section-inner">
        <SectionHeading
          level={3}
          anchor="install"
          title="Install Omarchy"
          description="Be up and running in as little as 35 seconds on the fastest machines, and in less than two minutes on the majority of computers."
          href="/manual/getting-started/"
          link="Full installation guide"
        />
        <div class="install-grid">
          <div class="install-card">
            <div class="install-title">
              <SiteIcon name="Usb" size={20} /><h4>
                Full-disk or dual-boot installation
              </h4>
            </div><p>
              Write the ISO to a USB stick and answer five questions. It hands
              back a finished desktop.
            </p><div class="install-action">
              <a class="btn btn--primary btn--lg" href={release.isoUrl}
                ><SiteIcon name="Download" size={20} />Download Omarchy {
                  release.version
                }</a
              ><p class="muted">
                Under a minute from stick to desktop. <span
                  >Verify the file: <a
                    class="text-link"
                    href={`${release.isoUrl}.sha256`}>SHA-256</a
                  >, <a class="text-link" href={`${release.isoUrl}.sig`}
                    >signature</a
                  >.</span
                >
              </p>
            </div>
          </div>
          <div class="install-card">
            <div class="install-title">
              <SiteIcon name="Display" size={20} /><h4>Try it first</h4>
            </div><p>
              All of Omarchy running in a virtual machine, so you can get a
              taste first.
            </p><div class="install-action">
              <div class="actions">
                <a
                  class="btn btn--lg"
                  data-try="mac"
                  href="https://github.com/omacom/try-omarchy"
                  ><SiteIcon name="Apple" size={20} />Try on Mac<SiteIcon
                    name="ArrowUpRight"
                    size={20}
                  /></a
                ><a
                  class="btn btn--lg"
                  data-try="windows"
                  href="https://github.com/omacom/try-omarchy-windows"
                  ><SiteIcon name="Windows" size={20} />Try on Windows<SiteIcon
                    name="ArrowUpRight"
                    size={20}
                  /></a
                >
              </div><p class="muted">
                Apple Silicon Macs, Windows 10 and 11.<span
                  >On Linux, the ISO is the way in.</span
                >
              </p>
            </div>
          </div>
        </div>
        <p class="muted install-note">
          The manual also covers <a
            href="/manual/dual-boot-install/"
            class="text-link">dual booting beside Windows</a
          > and <a href="/manual/unattended-installs/" class="text-link"
            >unattended installs</a
          >.
        </p>
        <a
          class="section-link section-mobile-link"
          href="/manual/getting-started/"
          >Full installation guide<SiteIcon name="ArrowRight" size={20} /></a
        >
      </div>
    </section>
    <section id="hardware" class="section section--deep">
      <div class="section-inner"><FeatureShowcase kind="hardware" /></div>
    </section>
    <section id="plugins" class="section">
      <div class="section-inner">
        <SectionHeading
          anchor="plugins"
          title="A plugin for every dream, every desire"
          description="Thousands of community plugins are available for Omarchy. Don't find what you need? Just put your agent on the job, then share when done."
          href="https://plugins.omarchy.org"
          link="All plugins"
        /><CardRail
          >{
            featured.map((plugin) => (
              <PluginCard
                plugin={{
                  ...plugin,
                  stats:
                    pluginStats.plugins[
                      plugin.id as keyof typeof pluginStats.plugins
                    ],
                }}
              />
            ))
          }</CardRail
        ><a
          class="section-link section-mobile-link"
          href="https://plugins.omarchy.org"
          >All plugins<SiteIcon name="ArrowRight" size={20} /></a
        >
      </div>
    </section>
    <section id="agents" class="section section--deep">
      <div class="section-inner"><FeatureShowcase kind="agents" /></div>
    </section>
    <section id="themes" class="section">
      <div class="section-inner">
        <SectionHeading
          anchor="themes"
          title="Pick a theme, change everything"
          href="/themes/"
          link="More community themes"
          ><Fragment slot="description"
            >A theme restyles the whole system at once: terminal, bar,
            notifications, wallpaper. Pick one and this site wears it too.<span
              class="desktop-inline"
            >
              Or press <kbd>T</kbd> to flip through them.</span
            ></Fragment
          ></SectionHeading
        ><ThemeShowcase /><a
          class="section-link section-mobile-link"
          href="/themes/"
          >More community themes<SiteIcon name="ArrowRight" size={20} /></a
        >
      </div>
    </section>
    <section id="developers" class="section section--deep">
      <div class="section-inner"><FeatureShowcase kind="developers" /></div>
    </section>
    <section id="gaming" class="section">
      <div class="section-inner"><FeatureShowcase kind="gaming" /></div>
    </section>
    <section id="windows" class="section section--deep">
      <div class="section-inner"><WindowsShowcase /></div>
    </section>
    <section id="news" class="section">
      <div class="section-inner">
        <SectionHeading
          anchor="news"
          title="What's been happening"
          href="/news/"
          link="All news"
        /><NewsList posts={news.slice(0, 6)} compact /><a
          class="section-link section-mobile-link"
          href="/news/">All news<SiteIcon name="ArrowRight" size={20} /></a
        >
      </div>
    </section>
    <section id="figures" class="section section--deep">
      <div class="section-inner">
        <SectionHeading
          anchor="figures"
          title="Momentum by the numbers"
          description="Donations, downloads, and contributions. Momentum is based on all of it."
        /><StatGrid />
      </div>
    </section>
    <section id="voices" class="section">
      <div class="section-inner">
        <SectionHeading
          anchor="voices"
          title="People love Omarchy"
          description="What people posted on X after installing it."
          href="https://x.com/search?q=omarchy&f=live"
          link="More on X"
          socialLink
        /><Voices /><a
          class="section-link section-mobile-link"
          href="https://x.com/search?q=omarchy&f=live"
          >More on <SiteIcon name="X" size={20} /><SiteIcon
            name="ArrowUpRight"
            size={20}
          /></a
        >
      </div>
    </section>
    <section id="teams" class="section section--deep">
      <div class="section-inner">
        <SectionHeading
          anchor="teams"
          title="It takes a village to raise a distro"
          description="Omarchy Core sets the direction, the Security team keeps your system safe, Design shapes how it looks and feels, and the Rangers help others find their way."
          href="/teams/"
          link="All teams"
        /><TeamClusters /><a
          class="section-link section-mobile-link"
          href="/teams/">All teams<SiteIcon name="ArrowRight" size={20} /></a
        >
      </div>
    </section>
    <section id="patrons" class="section">
      <div class="section-inner">
        <SectionHeading
          anchor="patrons"
          title="Backed by the oligarchy"
          description="The billionaires, mere millionaires, and corporations funding the lion's share of the development, maintenance, and spread of Omarchy."
          href="/patrons/"
          link="All patrons"
        /><TeamClusters groups={patronGroups} maxFaces={12} patrons /><p
          class="patron-note"
        >
          <a class="text-link" href="https://oligarchy.fyi"
            >Our shadowy agenda? Better Linux.</a
          >
        </p><a class="section-link section-mobile-link" href="/patrons/"
          >All patrons<SiteIcon name="ArrowRight" size={20} /></a
        >
      </div>
    </section>
    <section id="meetups" class="section section--deep meetup-section">
      <MeetupShowcase />
    </section>
    <section id="community" class="section">
      <div class="section-inner">
        <SectionHeading
          anchor="community"
          title="Get involved with Omarchy"
          description="Command your agent, and hang out with the people doing the same."
        /><div class="community-grid">
          {
            home.community.map((card) => (
              <a href={card.href}>
                <>
                  <SiteIcon
                    name={
                      card.icon as
                        "Discord" | "CalendarFilled" | "Github" | "Bank"
                    }
                    size={20}
                  />
                  <h3>{card.title}</h3>
                  <p>{card.body}</p>
                  <span>
                    {card.cta}
                    <SiteIcon name="ArrowRight" size={16} />
                  </span>
                </>
              </a>
            ))
          }
        </div>
      </div>
    </section>
  </main>
</SiteLayout>
<style>
  .meetup-section {
    padding-block: var(--space-12);
  }
  @media (min-width: 64rem) {
    .meetup-section {
      padding-block: var(--space-24);
    }
  }
  .hero {
    position: relative;
    margin-top: calc(-1 * var(--nav-h));
    padding-top: var(--nav-h);
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-bottom: 1px solid var(--color-border);
    background: var(--t-field-bg);
    user-select: none;
    -webkit-touch-callout: none;
  }
  .hero > canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .hero-body {
    position: relative;
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: center;
    padding-inline: var(--space-6);
    pointer-events: none;
  }
  .hero-spacer {
    flex: 1;
  }
  .hero-callout-wrap {
    pointer-events: auto;
    display: flex;
    justify-content: center;
    width: 100%;
    margin-bottom: var(--space-12);
  }
  .hero-callout {
    display: inline-flex;
    max-width: 100%;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-1_5) var(--space-3_5);
    border: 1px solid color-mix(in oklch, var(--color-brand) 40%, transparent);
    background: color-mix(in oklch, var(--color-bg) 60%, transparent);
    font-size: var(--text-caption);
    line-height: 1.375;
    text-align: left;
    color: var(--color-brand);
    text-decoration: none;
    transition:
      color 150ms ease-out,
      background-color 150ms ease-out,
      border-color 150ms ease-out;
  }
  .hero-callout span {
    min-width: 0;
  }
  .hero-callout :global(svg) {
    flex-shrink: 0;
    transition: transform 150ms ease-out;
  }
  .hero-callout:hover {
    background: var(--color-brand);
    border-color: var(--color-brand);
    color: var(--color-bg);
  }
  .hero-callout:hover :global(svg) {
    transform: translateX(2px);
  }
  .hero-body :global(.hero-wordmark) {
    width: 88%;
    max-width: 56rem;
    color: var(--t-field-lit);
  }
  .hero-body :global([data-painted]) {
    visibility: hidden;
  }
  .hero-copy {
    pointer-events: auto;
    margin-top: var(--space-12);
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    max-width: 42rem;
    text-align: center;
  }
  h1 {
    margin: 0;
    font-size: var(--text-2xl);
    line-height: 1.333333;
    font-weight: 500;
    letter-spacing: -0.025em;
  }
  .section-anchor {
    color: inherit;
    text-decoration: none;
  }
  h1 .dhh-link {
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 6px;
  }
  h1 .dhh-link:hover {
    text-decoration-color: var(--color-brand);
  }
  .hero-copy p {
    margin: var(--space-4) 0 0;
    font-size: var(--text-body);
    line-height: 1.625;
    color: var(--color-text-secondary);
  }
  .hero-copy p span {
    display: block;
    text-wrap: balance;
  }
  .hero-actions {
    margin-top: var(--space-9);
    display: flex;
    width: 100%;
    max-width: 20rem;
    flex-direction: column;
    align-items: stretch;
    gap: var(--space-3);
  }
  .hero-actions .btn {
    height: var(--space-10);
    padding: 0 var(--space-4) 0 var(--space-3);
    font-size: var(--text-body);
    line-height: 1.5;
  }
  .hero-actions .btn:not(.btn--primary) :global(svg) {
    margin-right: 2px;
  }
  .intro-grid {
    display: grid;
    gap: var(--space-8);
  }
  .intro-grid h2 {
    margin: 0;
    font-size: var(--text-2xl);
    line-height: 1.333333;
    font-weight: 600;
    contain: layout;
  }
  .intro-prose {
    margin-top: var(--space-6);
  }
  .intro-prose :global(p) {
    margin: 0;
    max-width: 35.5rem;
    font-size: var(--text-body);
    line-height: 1.625;
    color: var(--color-text-secondary);
    text-wrap: pretty;
  }
  .intro-prose :global(p + p) {
    margin-top: var(--space-5);
  }
  .intro-prose :global(a) {
    text-decoration: underline;
    text-decoration-color: var(--color-border-strong);
    text-underline-offset: 4px;
  }
  .quote {
    position: relative;
    margin: 0;
    max-width: 28rem;
    border: 1px solid var(--color-border-subtle);
    background: var(--color-surface);
    padding: var(--space-5);
    transition: border-color 150ms ease-out;
  }
  .quote:hover {
    border-color: var(--color-border-strong);
  }
  .quote-mark {
    display: block;
    height: var(--space-10);
    font-family: var(--font-sans);
    font-size: var(--text-6xl);
    line-height: 1;
    font-weight: 700;
    color: var(--color-brand);
  }
  blockquote {
    margin: 0;
    padding: 0;
    border: 0;
    font-family: var(--font-sans);
    font-size: var(--text-xl);
    line-height: 1.375;
    font-weight: 500;
    font-style: normal;
    color: var(--color-text);
    text-wrap: balance;
  }
  figcaption {
    display: flex;
    align-items: center;
    gap: var(--space-3_5);
    margin-top: var(--space-6);
  }
  figcaption img {
    width: var(--space-12);
    height: var(--space-12);
    flex-shrink: 0;
    border: 1px solid var(--color-border-subtle);
    object-fit: cover;
  }
  figcaption > span {
    display: flex;
    flex-direction: column;
    font-family: var(--font-mono);
    line-height: 1.375;
    font-size: var(--text-caption);
    color: var(--color-text-muted);
  }
  figcaption .quote-name {
    font-size: var(--text-body);
    font-weight: 500;
    color: var(--color-text);
  }
  figcaption > a {
    margin-left: auto;
    color: var(--color-text-muted);
  }
  figcaption > a::before {
    content: "";
    position: absolute;
    inset: 0;
  }
  .quote:hover figcaption > a {
    color: var(--color-text);
  }
  .watch-band {
    padding-block: var(--space-12);
    border-block: 1px solid var(--color-border-subtle);
  }
  .install-grid {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-6);
  }
  .install-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: var(--space-6);
    background: var(--color-surface);
    box-shadow: var(--shadow-card);
  }
  .install-title {
    display: flex;
    align-items: center;
    gap: var(--space-2_5);
  }
  .install-title :global(svg) {
    color: var(--color-brand);
    flex-shrink: 0;
  }
  .install-title h4 {
    margin: 0;
    font-size: var(--text-lg);
    line-height: 1.555556;
    font-weight: 500;
    letter-spacing: -0.025em;
  }
  .install-card > p {
    margin: var(--space-3) 0 0;
    font-size: var(--text-body);
    line-height: 1.625;
    color: var(--color-text-secondary);
    text-wrap: pretty;
  }
  .install-action {
    margin-top: auto;
    padding-top: var(--space-6);
  }
  .install-action p {
    margin: var(--space-2_5) 0 0;
    font-size: var(--text-caption);
    line-height: 1.5;
  }
  .install-action p span {
    display: block;
  }
  .install-action .actions {
    gap: var(--space-2);
  }
  .install-note {
    margin-top: var(--space-6);
    line-height: 1.625;
    text-wrap: pretty;
  }
  #install .text-link {
    color: var(--color-text);
    transition: text-decoration-color var(--duration-fast) var(--ease-out);
  }
  #install .text-link:hover {
    text-decoration-color: var(--color-accent);
  }
  .patron-note {
    margin: var(--space-4) 0 0;
    font-size: var(--text-xs);
    line-height: 1.333333;
    color: var(--color-text-muted);
  }
  .community-grid {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-6);
  }
  .community-grid > a {
    display: flex;
    flex-direction: column;
    padding: var(--space-5);
    background: var(--color-surface);
    box-shadow: var(--shadow-card);
    text-decoration: none;
    transition:
      box-shadow 150ms ease-out,
      background-color 150ms ease-out;
  }
  .community-grid > a:hover {
    box-shadow: var(--shadow-elevated);
  }
  .community-grid :global(svg) {
    color: var(--color-brand);
    flex-shrink: 0;
  }
  .community-grid h3 {
    font-size: var(--text-body);
    font-weight: 500;
    line-height: 1.5;
    margin: var(--space-3_5) 0 0;
    letter-spacing: normal;
  }
  .community-grid p {
    font-size: var(--text-caption);
    line-height: 1.625;
    color: var(--color-text-secondary);
    margin: var(--space-1_5) 0 0;
    text-wrap: pretty;
  }
  .community-grid span {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    padding-top: var(--space-4);
    margin-top: auto;
    color: var(--color-brand);
    font-size: var(--text-caption);
    font-weight: 500;
    line-height: 1.5;
  }
  .community-grid span :global(svg) {
    transition: transform 150ms ease-out;
  }
  .community-grid > a:hover span :global(svg) {
    transform: translateX(2px);
  }
  .desktop-inline {
    display: none;
  }
  kbd {
    border: 1px solid var(--color-border-strong);
    padding: 2px 6px;
