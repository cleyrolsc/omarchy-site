---
import { getEntry, render } from "astro:content";
import {
  Download,
  Play,
  ArrowRight,
  Usb,
  Monitor,
  Apple,
  Shirt,
  Calendar,
  MessageCircle,
  Heart,
} from "@lucide/astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import Brand from "../components/Brand.astro";
import EffectPicker from "../components/EffectPicker.astro";
import SectionHeading from "../components/SectionHeading.astro";
import PluginCard from "../components/PluginCard.astro";
import ThemeShowcase from "../components/ThemeShowcase.astro";
import VideoCarousel from "../components/VideoCarousel.astro";
import TeamClusters from "../components/TeamClusters.astro";
import NewsList from "../components/NewsList.astro";
import StatGrid from "../components/StatGrid.astro";
import Voices from "../components/Voices.astro";
import home from "../data/home.json";
import release from "../data/version.json";
import banner from "../data/banner.json";
import catalogue from "../data/plugins.json";
import patrons from "../data/patrons.json";
import { newsSummaries } from "../lib/content";
const intro = (await getEntry("marketing", "home"))!;
const { Content } = await render(intro);
const news = await newsSummaries();
const featured = home.featuredPluginIds
  .map((id) => catalogue.plugins.find((p) => p.id === id))
  .filter((p): p is (typeof catalogue.plugins)[number] => Boolean(p));
const patronGroups = patrons.map((group) => ({
  ...group,
  name:
    group.id === "founding-token-patrons"
      ? "Founding Corporate Patrons"
      : group.name,
  description:
    group.id === "founding-token-patrons"
      ? "$1,000,000/year x 3 or $1,500,000 in tokens"
      : group.id === "distinguished-corporate-patrons"
        ? "$100,000/year x 3 or $150,000 in tokens"
        : group.description,
}));
const communityIcons = [MessageCircle, Calendar, Heart, Shirt];
---

<SiteLayout title={intro.data.title} description={intro.data.description}>
  <main id="main">
    <section class="hero" data-hero-sentinel>
      <canvas data-pixel-field="hero" aria-hidden="true"></canvas>
      <EffectPicker />
      <div class="hero-body">
        {
          banner && (
            <a class="hero-callout" data-hero-quiet href={banner.href}>
              <>
                <span set:html={banner.html} />
                <ArrowRight size={16} />
              </>
            </a>
          )
        }
        <Brand hero class="hero-wordmark" />
        <div class="hero-copy" data-hero-quiet>
          <h1>
            <span class="sr-only">Omarchy: </span>Beautiful, fun &amp; agentic
            Linux by <a href="https://dhh.dk">DHH</a>
          </h1>
          <p>
            <span>The malleable OS for the age of agents.</span><span
              >Vibe your way through every alteration, tweak, and desire.</span>
          </p>
          <div class="actions hero-actions">
            <a class="btn btn--primary" href="#install"
              ><Download size={20} />Get Omarchy</a
            ><a class="btn" href="#watch"><Play size={20} />See it in action</a>
          </div>
        </div>
      </div>
    </section>
    <section>
      <div class="section-inner intro-grid">
        <div>
          <h2>
            <a href="https://wecanfixeverything.com/" class="text-link"
              ><span class="sr-only">We can fix everything.</span><span
                aria-hidden="true"
                >We can fix every<span data-typewriter>thing.</span></span
              ></a>
          </h2><div class="intro-prose"><Content /></div>
        </div><figure class="quote">
          <span class="quote-mark" aria-hidden="true">“</span><blockquote
            cite={home.quote.href}
          >
            {home.quote.text}
          </blockquote><figcaption>
            <img
              src="/assets/images/team/dhh.webp"
              alt=""
              width="96"
              height="96"
              loading="lazy"
            /><span
              ><strong>{home.quote.name}</strong><span>{home.quote.role}</span
              ></span
            ><a href={home.quote.href} aria-label="Watch him say it on YouTube"
              ><Play size={20} /></a>
          </figcaption>
        </figure>
      </div>
    </section>
    <section id="watch" class="section section--deep">
      <div class="section-inner">
        <SectionHeading
          title="See it in action"
          description="Experience a transfer of enthusiasm."
          level={2}
        /><div class="section-content">
          <VideoCarousel videos={home.videos} />
        </div>
      </div>
    </section>
    <section id="install" class="section">
      <div class="section-inner">
        <SectionHeading
          title="Install Omarchy"
          description="Be up and running in as little as 35 seconds on the fastest machines, and in less than two minutes on the majority of computers."
          href="/manual/getting-started/"
          link="Full installation guide"
          level={2}
        />
        <div class="install-grid">
          <article class="install-card">
            <h3 class="install-title">
              <Usb size={20} />Full-disk or dual-boot installation
            </h3><p>
              Write the ISO to a USB stick and answer five questions. It hands
              back a finished desktop.
            </p><div class="install-action">
              <a class="btn btn--primary" href={release.isoUrl}
                ><Download size={20} />Download Omarchy {release.version}</a
              ><p class="muted">
                Under a minute from stick to desktop. <span
                  >Verify the file: <a
                    class="text-link"
                    href={`${release.isoUrl}.sha256`}>SHA-256</a
                  >, <a class="text-link" href={`${release.isoUrl}.sig`}
                    >signature</a
                  >.</span>
              </p>
            </div>
          </article>
          <article class="install-card">
            <h3 class="install-title"><Monitor size={20} />Try it first</h3><p>
              All of Omarchy running in a virtual machine, so you can get a
              taste first.
            </p><div class="install-action">
              <div class="actions">
                <a
                  class="btn"
                  data-try="mac"
                  href="https://github.com/omacom/try-omarchy"
                  ><Apple size={20} />Try on Mac ↗</a
                ><a
                  class="btn"
                  data-try="windows"
                  href="https://github.com/omacom/try-omarchy-windows"
                  ><Monitor size={20} />Try on Windows ↗</a>
              </div><p class="muted">
                Apple Silicon Macs, Windows 10 and 11.<span
                  >On Linux, the ISO is the way in.</span>
              </p>
            </div>
          </article>
        </div>
        <p class="muted install-note">
          The manual also covers <a
            href="/manual/dual-boot-install/"
            class="text-link">dual booting beside Windows</a
          > and <a href="/manual/unattended-installs/" class="text-link"
            >unattended installs</a
          >.
        </p>
      </div>
    </section>
    <section id="hardware" class="section section--deep">
      <div class="section-inner">
        <SectionHeading
          title="It runs on almost anything"
          description="You don't need a new machine to try Omarchy. But if you get one, today's laptops are amazing."
        /><div class="hardware-grid">
          {
            home.hardware.map((item) => (
              <article>
                <>
                  <h3>
                    <Monitor size={20} />
                    {item.title}
                  </h3>
                  <p>{item.description}</p>
                  <a class="section-link" href={item.href}>
                    {item.link}
                    <ArrowRight size={18} />
                  </a>
                </>
              </article>
            ))
          }
        </div>
      </div>
    </section>
    <section class="section">
      <div class="section-inner">
        <SectionHeading
          title="A plugin for every dream, every desire"
          description={`${catalogue.plugins.length.toLocaleString("en-US")} community plugins for the Quattro shell: bars, widgets, overlays, and services, each one a single command away.`}
          href="https://plugins.omarchy.org"
          link="All plugins"
        /><div class="rail section-content">
          {featured.map((plugin) => <PluginCard plugin={plugin} />)}
        </div>
      </div>
    </section>
    <section class="section section--deep">
      <div class="section-inner">
        <SectionHeading
          title="Pick a theme, change everything"
          description="A theme restyles the whole system at once: terminal, bar, notifications, wallpaper. Pick one and this site wears it too. Or press T to flip through them."
          href="/themes/"
          link="More community themes"
        /><ThemeShowcase />
      </div>
    </section>
    <section class="section">
      <div class="section-inner">
        <SectionHeading
          title="What's been happening"
          href="/news/"
          link="All news"
        /><NewsList posts={news.slice(0, 6)} compact />
      </div>
    </section>
    <section id="figures" class="section section--deep">
      <div class="section-inner">
        <SectionHeading
          title="Momentum by the numbers"
          description="Donations, downloads, and contributions. Momentum is based on all of it."
        /><StatGrid />
      </div>
    </section>
    <section id="voices" class="section">
      <div class="section-inner">
        <SectionHeading
          title="People love Omarchy"
          description="What people posted on X after installing it."
          href="https://x.com/search?q=omarchy&f=live"
          link="More on X"
        /><Voices />
      </div>
    </section>
    <section class="section section--deep">
      <div class="section-inner">
        <SectionHeading
          title="It takes a village to raise a distro"
          description="Omarchy Core sets the direction, the Security team keeps your system safe, Design shapes how it looks and feels, and the Rangers help others find their way."
          href="/teams/"
          link="All teams"
        /><TeamClusters />
      </div>
    </section>
    <section id="patrons" class="section">
      <div class="section-inner">
        <SectionHeading
          title="Backed by the oligarchy"
          description="The billionaires, mere millionaires, and corporations funding the development, maintenance, and spread of Omarchy."
          href="/patrons/"
          link="All patrons"
        /><TeamClusters
          groups={patronGroups}
          maxFaces={12}
          basePath="/patrons/"
        /><p class="muted install-note">
          <a href="https://oligarchy.fyi" class="text-link"
            >Our shadowy agenda? Better Linux.</a>
        </p>
      </div>
    </section>
    <section class="section section--deep">
      <div class="section-inner">
        <SectionHeading
          title="Get involved with Omarchy"
          description="Command your agent, and hang out with the people doing the same."
        /><div class="community-grid">
          {
            home.community.map((card, index) => {
              const Icon = communityIcons[index];
              return (
                <a href={card.href}>
                  <>
                    <Icon size={20} />
                    <h3>{card.title}</h3>
                    <p>{card.body}</p>
                    <span>
                      {card.cta}
                      <ArrowRight size={16} />
                    </span>
                  </>
                </a>
              );
            })
          }
        </div>
      </div>
    </section>
  </main>
</SiteLayout>
<style>
  .hero {
    position: relative;
    min-height: 100svh;
    margin-top: calc(-1 * var(--nav-h));
    padding-top: var(--nav-h);
    display: flex;
    overflow: hidden;
    border-bottom: 1px solid var(--color-border);
    background: var(--t-field-bg);
  }
  .hero > canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .hero-body {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: var(--space-16) var(--space-6);
    pointer-events: none;
  }
  .hero-callout {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    pointer-events: auto;
    margin-bottom: var(--space-12);
    max-width: 100%;
    padding: var(--space-2) var(--space-3);
    font-size: var(--text-caption);
    border: 1px solid var(--color-border-strong);
    background: var(--color-surface);
    color: var(--color-brand);
    text-decoration: none;
    text-align: center;
  }
  .hero-body :global(.hero-wordmark) {
    width: 88%;
    max-width: 56rem;
  }
  .hero-body :global([data-painted]) {
    visibility: hidden;
  }
  .hero-copy {
    margin-top: var(--space-12);
    max-width: 42rem;
    text-align: center;
    pointer-events: auto;
  }
  h1 {
    font-size: var(--text-2xl);
    font-weight: var(--font-medium);
    letter-spacing: var(--tracking-tight);
    margin: 0;
  }
  h1 a {
    text-decoration: none;
  }
  h1 a:hover {
    text-decoration: underline;
    text-decoration-color: var(--color-brand);
  }
  .hero-copy p {
    margin: var(--space-4) 0 0;
    color: var(--color-text-secondary);
    text-wrap: balance;
  }
  .hero-copy p span {
    display: block;
  }
  .hero-actions {
    margin-top: var(--space-8);
    justify-content: center;
  }
  .intro-grid {
    display: grid;
    gap: var(--space-8);
  }
  .intro-grid h2 {
    margin: 0;
  }
  .intro-grid h2 a {
    color: var(--color-text);
  }
  .intro-prose :global(p) {
    color: var(--color-text-secondary);
  }
  .intro-prose {
    margin-top: var(--space-6);
    color: var(--color-text-secondary);
  }
  .intro-prose :global(p + p) {
    margin-top: var(--space-5);
  }
  .quote {
    margin: 0;
    padding: var(--space-6);
    max-width: 28rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
  }
  .quote-mark {
    display: block;
    height: var(--space-10);
    font-family: var(--font-sans);
    font-size: var(--text-display);
    line-height: 1;
    color: var(--color-brand);
  }
  blockquote {
    margin: 0;
    padding: 0;
    border: 0;
    color: var(--color-text);
    font-family: var(--font-sans);
    font-size: var(--text-xl);
    line-height: 1.4;
    font-weight: var(--font-medium);
    text-wrap: balance;
  }
  figcaption {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }
  figcaption img {
    width: var(--space-12);
    height: var(--space-12);
    object-fit: cover;
  }
  figcaption > span {
    display: grid;
    font-size: var(--text-caption);
  }
  figcaption > span > span {
    color: var(--color-text-muted);
  }
  figcaption > a {
    margin-left: auto;
  }
  .install-grid {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-8);
  }
  .install-card {
    display: flex;
    flex-direction: column;
    padding: var(--space-6);
    background: var(--color-surface);
    box-shadow: var(--shadow-card);
  }
  .install-title {
    display: flex;
    align-items: center;
    gap: var(--space-2_5);
    margin: 0;
    font-size: var(--text-lg);
  }
  .install-title svg,
  .hardware-grid h3 svg {
    color: var(--color-brand);
    flex-shrink: 0;
  }
  .install-card > p {
    margin-top: var(--space-3);
    color: var(--color-text-secondary);
  }
  .install-action {
    padding-top: var(--space-6);
    margin-top: auto;
  }
  .install-action p {
    margin-top: var(--space-2_5);
  }
  .install-action p span {
    display: block;
  }
  .install-note {
    margin-top: var(--space-6);
  }
  .hardware-grid {
    display: grid;
    gap: var(--space-6);
    margin-top: var(--space-8);
  }
  .hardware-grid article {
    border-top: 1px solid var(--color-border-strong);
    padding-top: var(--space-4);
    display: flex;
    flex-direction: column;
  }
  .hardware-grid h3 {
    display: flex;
    align-items: center;
    gap: var(--space-2_5);
    margin: 0;
  }
  .hardware-grid p {
    margin: var(--space-3) 0;
    color: var(--color-text-secondary);
  }
  .hardware-grid a {
    margin-top: auto;
  }
  .community-grid {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-8);
  }
  .community-grid > a {
    display: flex;
    flex-direction: column;
    padding: var(--space-5);
    background: var(--color-surface);
    box-shadow: var(--shadow-card);
    text-decoration: none;
  }
  .community-grid svg {
    color: var(--color-brand);
  }
  .community-grid h3 {
    font-size: var(--text-body);
    margin: var(--space-3_5) 0 var(--space-1_5);
  }
  .community-grid p {
    font-size: var(--text-caption);
    color: var(--color-text-secondary);
    margin: 0;
  }
  .community-grid span {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    padding-top: var(--space-4);
    margin-top: auto;
    color: var(--color-brand);
    font-size: var(--text-caption);
  }
  @media (min-width: 40rem) {
    .intro-grid h2 {
      font-size: var(--text-section-title);
    }
    h1 {
      font-size: var(--text-3xl);
    }
    .community-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 48rem) {
    .install-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .hardware-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (min-width: 64rem) {
    .intro-grid {
      grid-template-columns: 1.35fr 1fr;
      gap: var(--space-20);
      align-items: center;
    }
    .community-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .hero-callout {
      margin-bottom: calc(var(--pxr) * 5);
    }
    .hero-copy {
      margin-top: calc(var(--pxr) * 5);
    }
  }
  @media (max-width: 40rem) {
    .hero-actions {
      flex-direction: column;
      width: min(100%, 20rem);
      margin-inline: auto;
      align-items: stretch;
    }
    .hero-body {
      padding-block: var(--space-12);
    }
  }
</style>
