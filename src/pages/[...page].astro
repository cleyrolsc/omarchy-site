---
import { getCollection, render } from "astro:content";
import PageHeader from "../components/PageHeader.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import RedirectPage from "../layouts/RedirectPage.astro";
import { redirects } from "../lib/redirects";
export async function getStaticPaths() {
  return [
    ...(await getCollection("pages"))
      .filter((page) => !["teams", "meetups"].includes(page.id))
      .map((page) => ({
        params: { page: page.id },
        props: { page, to: undefined },
      })),
    ...Object.entries(redirects).map(([path, to]) => ({
      params: { page: path.replace(/^\/|\/$/g, "") },
      props: { page: undefined, to },
    })),
  ];
}
const { page, to } = Astro.props;
const rendered = page ? await render(page) : undefined;
const Content = rendered?.Content;
const narrow = [
  "patrons/badges",
  "server",
  "meetups",
  "air",
  "foundation",
  "sponsorships",
  "security",
  "security/credits",
  "brand",
  "omakub",
].includes(page?.id || "");
const sharedHeader = page?.id === "patrons" || page?.id.startsWith("security");
---

{
  to ? (
    <RedirectPage to={to} />
  ) : (
    page &&
    Content && (
      <SiteLayout
        title={page.data.seoTitle || page.data.title}
        description={page.data.description}
        canonicalPath={page.data.path}
      >
        <main
          id="main"
          class:list={[
            "page",
            { "page--reading": narrow, "shared-header": sharedHeader },
          ]}
        >
          <>
            {sharedHeader ? (
              <PageHeader title={page.data.title} />
            ) : (
              <h1 class:list={[{ centered: page.id === "patrons/badges" }]}>
                {page.data.title}
              </h1>
            )}
            <div
              class:list={[
                "prose ported standalone-content",
                {
                  subtitle: ["foundation", "potato"].includes(page.id),
                },
              ]}
            >
              {page.data.format === "html" ? (
                <Fragment set:html={page.body} />
              ) : (
                <Content />
              )}
            </div>
          </>
        </main>
      </SiteLayout>
    )
  )
}
<style>
  .shared-header {
    padding-block: var(--space-8);
  }
  h1 {
    margin: 0;
    font-size: var(--text-3xl);
    line-height: 1.2;
    font-weight: 600;
  }
  .centered {
    text-align: center;
  }
  .standalone-content.subtitle {
    margin-top: var(--space-2);
  }
  .standalone-content {
    margin-top: var(--space-8);
  }
</style>
