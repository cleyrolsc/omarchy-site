{
  "name": "omarchy-site",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -n astro,storybook -c blue,magenta \"astro dev\" \"storybook dev -p 6006 --host 127.0.0.1 --no-open\"",
    "dev:astro": "astro dev",
    "dev:storybook": "storybook dev -p 6006 --host 127.0.0.1",
    "start": "astro dev",
    "build": "astro build",
    "build:storybook": "astro build --config .storybook/astro.config.mjs && storybook build -o storybook-static",
    "preview": "astro preview",
    "preview:cloudflare": "wrangler dev --local",
    "check:cloudflare": "wrangler deploy --dry-run",
    "deploy:preview": "wrangler versions upload",
    "astro": "astro",
    "storybook": "storybook dev -p 6006 --host 127.0.0.1",
    "check": "astro check",
    "typecheck": "astro check",
    "refresh-data": "node scripts/refresh-data.mjs",
    "parity": "node tests/parity.mjs",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.1.2",
    "@astrojs/mdx": "^5.0.4",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.2",
    "@lucide/astro": "^1.17.0",
    "astro": "^6.4.6",
    "turndown": "^7.2.0",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.58.0",
    "@storybook/addon-docs": "^10.3.5",
    "@storybook/builder-vite": "^10.3.5",
    "@types/turndown": "^5.0.5",
    "cheerio": "^1.2.0",
    "concurrently": "^10.0.3",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "sharp": "^0.35.4",
    "storybook": "^10.3.5",
    "storybook-astro": "^0.2.1",
    "typescript": "^5.7.0",
    "wrangler": "^4.129.0"
  },
  "overrides": {
    "yaml-language-server": {
      "yaml": "^2.9.0"
    }
  }
}
